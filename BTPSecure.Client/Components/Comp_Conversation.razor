@inject Services.S_Ticket STicket
@inject NotificationService Notification
@inject DialogService Dialog

@if (_chargement)
{
    <RadzenRow JustifyContent="JustifyContent.Center" Style="margin: 2rem 0;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
    </RadzenRow>
}
else
{
    <RadzenStack Gap="0.75rem" Style="margin-bottom: 1rem;">
        @if (_fil.Count == 0)
        {
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 2rem 0;">
                <RadzenIcon Icon="chat" Style="font-size: 2.5rem; color: var(--rz-text-disabled-color);" />
                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">Aucun message pour l'instant. Écrivez le premier !</RadzenText>
            </RadzenStack>
        }
        else
        {
            @foreach (var _t in _fil)
            {
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="@AlignementBulle(_t)" Style="width: 100%;">
                    <RadzenCard Variant="Variant.Filled" Style="@StyleBulle(_t)">
                        <RadzenStack Gap="0.35rem">
                            <RadzenText TextStyle="TextStyle.Body2" Style="@StyleTexteBulle(_t)">@_t.Message</RadzenText>
                            @if (_t.ADocumentJoint)
                            {
                                <RadzenButton Text="Pièce jointe" Icon="attach_file" ButtonStyle="ButtonStyle.Light"
                                              Variant="Variant.Flat" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => VoirPieceJointe(_t.Id))" />
                            }
                            <RadzenText TextStyle="TextStyle.Caption" Style="@StyleHeureBulle(_t)">
                                @_t.DateCreation.ToLocalTime().ToString("dd/MM HH:mm")
                            </RadzenText>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            }
        }
    </RadzenStack>

    <RadzenCard Variant="Variant.Outlined">
        <RadzenStack Gap="0.6rem">
            <RadzenTextArea Value="@_repMessage" @oninput="MajReponse" Rows="2" Style="width: 100%;" MaxLength="5000" Placeholder="Votre réponse..." />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                <Comp_SelecteurPieceJointe @bind-Fichier="_repPieceJointe" />
                <RadzenButton Text="Envoyer" Icon="send" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                              Click="Repondre" Disabled="_envoiEnCours" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>
}

@code {
    [Parameter] public int AutreId { get; set; }
    [Parameter] public string NomAutre { get; set; } = string.Empty;
    [Parameter] public EventCallback OnChangement { get; set; }
    // Change à chaque rafraîchissement auto du parent → recharge silencieuse du fil
    [Parameter] public int RefreshTick { get; set; }

    private List<DTO_Ticket> _fil = new();
    private bool _chargement = true;
    private int _autreCharge = 0;
    private int _tickCharge = -1;
    private string _sujetFil = string.Empty;

    // Réponse
    private string _repMessage = string.Empty;
    private bool _envoiEnCours = false;
    private Comp_SelecteurPieceJointe.PieceJointe? _repPieceJointe;

    protected override async Task OnParametersSetAsync()
    {
        if (AutreId != _autreCharge)
        {
            // Ouverture d'un fil : chargement complet avec spinner + on prévient le parent (badge)
            _autreCharge = AutreId;
            _tickCharge = RefreshTick;
            await Charger(true, true);
        }
        else if (RefreshTick != _tickCharge)
        {
            // Rafraîchissement auto du parent : rechargement silencieux (pas de spinner, pas de notif)
            _tickCharge = RefreshTick;
            await Charger(false, false);
        }
    }

    private async Task Charger(bool p_avecSpinner, bool p_notifier)
    {
        if (p_avecSpinner)
            _chargement = true;
        _fil = await STicket.ObtenirConversation(AutreId);
        if (_fil.Count > 0)
            _sujetFil = _fil[0].Sujet;
        _chargement = false;
        // À l'ouverture, les messages viennent d'être marqués lus → prévenir le parent (liste + badge)
        if (p_notifier)
            await OnChangement.InvokeAsync();
    }

    private JustifyContent AlignementBulle(DTO_Ticket p_t)
    {
        if (p_t.EstEnvoyeParMoi)
            return JustifyContent.End;
        return JustifyContent.Start;
    }

    private string StyleBulle(DTO_Ticket p_t)
    {
        if (p_t.EstEnvoyeParMoi)
            return "background: var(--rz-primary); border-radius: 14px 14px 3px 14px; padding: 0.6rem 0.85rem; max-width: 82%;";
        return "background: var(--rz-base-200); border-radius: 14px 14px 14px 3px; padding: 0.6rem 0.85rem; max-width: 82%;";
    }

    private string StyleTexteBulle(DTO_Ticket p_t)
    {
        if (p_t.EstEnvoyeParMoi)
            return "white-space: pre-wrap; overflow-wrap: anywhere; color: #fff;";
        return "white-space: pre-wrap; overflow-wrap: anywhere;";
    }

    private string StyleHeureBulle(DTO_Ticket p_t)
    {
        if (p_t.EstEnvoyeParMoi)
            return "color: rgba(255,255,255,0.8); text-align: right;";
        return "color: var(--rz-text-secondary-color);";
    }

    private void MajReponse(ChangeEventArgs p_e)
    {
        if (p_e.Value == null)
        {
            _repMessage = string.Empty;
            return;
        }
        var _s = p_e.Value.ToString();
        if (_s == null)
            _repMessage = string.Empty;
        else
            _repMessage = _s;
    }

    private async Task Repondre()
    {
        if (string.IsNullOrWhiteSpace(_repMessage))
        {
            Notification.Notify(NotificationSeverity.Error, "Message vide", "Écrivez une réponse.");
            return;
        }

        var _sujet = _sujetFil;
        if (string.IsNullOrWhiteSpace(_sujet))
            _sujet = "Message";

        var _dto = new DTO_EnvoyerTicket
        {
            DestinataireId = AutreId,
            Sujet = _sujet,
            Message = _repMessage.Trim()
        };

        if (_repPieceJointe != null)
        {
            _dto.PieceJointe = _repPieceJointe.Contenu;
            _dto.NomPieceJointe = _repPieceJointe.Nom;
            _dto.TypePieceJointe = _repPieceJointe.Type;
        }

        _envoiEnCours = true;
        var (_succes, _msg) = await STicket.Envoyer(_dto);
        _envoiEnCours = false;

        if (_succes)
        {
            _repMessage = string.Empty;
            _repPieceJointe = null;
            _fil = await STicket.ObtenirConversation(AutreId);
            await OnChangement.InvokeAsync();
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", _msg);
        }
    }

    private async Task VoirPieceJointe(int p_ticketId)
    {
        var _pj = await STicket.ObtenirPieceJointe(p_ticketId);
        if (_pj == null)
        {
            Notification.Notify(NotificationSeverity.Error, "Indisponible", "Pièce jointe introuvable.");
            return;
        }

        await Dialog.OpenAsync<Comp_PieceJointe>(_pj.Nom,
            new Dictionary<string, object?>
            {
                ["Nom"] = _pj.Nom,
                ["Type"] = _pj.Type,
                ["Base64"] = _pj.Base64
            },
            new DialogOptions { Width = "620px", CloseDialogOnOverlayClick = true });
    }
}
