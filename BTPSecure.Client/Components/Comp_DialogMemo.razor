@inject DialogService Dialog
@inject NotificationService Notification

@* Rédaction d'un pense-bête (création ou modification) *@

<RadzenStack Gap="1rem" Style="min-width: 320px;">

    <RadzenFormField Text="Titre" Variant="Variant.Outlined" Style="width: 100%;">
        <ChildContent>
            <RadzenTextBox Value="@_titre" @oninput="MajTitre" Style="width: 100%;" MaxLength="200"
                           Placeholder="Ex : Rappeler le fournisseur X" />
        </ChildContent>
    </RadzenFormField>

    <RadzenFormField Text="Note" Variant="Variant.Outlined" Style="width: 100%;">
        <ChildContent>
            <RadzenTextArea Value="@_contenu" @oninput="MajContenu" Rows="10" Style="width: 100%;" MaxLength="10000"
                            Placeholder="Écrivez votre pense-bête..." />
        </ChildContent>
    </RadzenFormField>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.75rem">
        <RadzenButton Text="Annuler" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(() => Dialog.Close())" />
        <RadzenButton Text="Enregistrer" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="Valider" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter] public int? MemoId { get; set; }
    [Parameter] public string TitreInitial { get; set; } = string.Empty;
    [Parameter] public string ContenuInitial { get; set; } = string.Empty;

    private string _titre = string.Empty;
    private string _contenu = string.Empty;

    protected override void OnInitialized()
    {
        _titre = TitreInitial;
        _contenu = ContenuInitial;
    }

    private void MajTitre(ChangeEventArgs p_e)
    {
        _titre = ObtenirTexte(p_e);
    }

    private void MajContenu(ChangeEventArgs p_e)
    {
        _contenu = ObtenirTexte(p_e);
    }

    private static string ObtenirTexte(ChangeEventArgs p_e)
    {
        if (p_e.Value == null)
            return string.Empty;
        var _s = p_e.Value.ToString();
        if (_s == null)
            return string.Empty;
        return _s;
    }

    private void Valider()
    {
        if (string.IsNullOrWhiteSpace(_titre))
        {
            Notification.Notify(NotificationSeverity.Error, "Titre manquant", "Donnez un titre à votre note.");
            return;
        }

        Dialog.Close(new DTO_EnregistrerMemo
        {
            Id = MemoId,
            Titre = _titre.Trim(),
            Contenu = _contenu
        });
    }
}
