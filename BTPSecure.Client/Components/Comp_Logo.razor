@code {
    // false = monogramme « K », true = mot-symbole « KEYDO »
    [Parameter] public bool Complet { get; set; }
    [Parameter] public string Hauteur { get; set; } = "1.5rem";

    private string ObtenirStyle()
    {
        // width auto conserve les proportions ; flex-shrink évite l'écrasement dans un RadzenStack
        return $"height: {Hauteur}; width: auto; display: block; flex-shrink: 0;";
    }
}
