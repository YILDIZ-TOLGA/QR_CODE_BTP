@inject DialogService Dialog

@* Pop-up de création de collaborateur : héberge le formulaire réutilisable et ferme avec l'email créé *@

<RadzenStack Style="min-width: 320px;">
    <Comp_FormCreerCollaborateur PeutCreerResponsableAdmin="PeutCreerResponsableAdmin" OnCree="Ferme" />
</RadzenStack>

@code {
    [Parameter] public bool PeutCreerResponsableAdmin { get; set; } = true;

    private void Ferme(string p_email)
    {
        Dialog.Close(p_email);
    }
}
