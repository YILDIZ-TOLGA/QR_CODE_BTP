@implements IDisposable
@inject IJSRuntime JS

<RadzenButton Icon="refresh" Text="Rafraîchir" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined"
              Size="ButtonSize.Small" IsBusy="_enCours" Click="Rafraichir" />

@code {
    // Rafraîchit automatiquement toutes les IntervalSeconds, sauf si l'onglet est en arrière-plan.
    // Fournit aussi un bouton manuel de rafraîchissement.
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public int IntervalSeconds { get; set; } = 60;

    private System.Timers.Timer? _timer;
    private bool _enCours;

    protected override void OnInitialized()
    {
        _timer = new System.Timers.Timer(IntervalSeconds * 1000);
        _timer.Elapsed += async (_, _) => await Tick();
        _timer.AutoReset = true;
        _timer.Start();
    }

    private async Task Tick()
    {
        await InvokeAsync(async () =>
        {
            bool _cache = false;
            try
            {
                _cache = await JS.InvokeAsync<bool>("eval", "document.hidden === true");
            }
            catch { }

            if (_cache)
            {
                return;
            }

            try
            {
                await OnRefresh.InvokeAsync();
            }
            catch { }
        });
    }

    private async Task Rafraichir()
    {
        _enCours = true;
        try
        {
            await OnRefresh.InvokeAsync();
        }
        catch { }
        _enCours = false;
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}
