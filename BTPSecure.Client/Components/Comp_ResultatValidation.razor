@inject IJSRuntime JS
@inject NotificationService Notification
@inject DialogService Dialog

@* Résultat d'une validation de code — source UNIQUE, réutilisée par l'Accueil
   fournisseur et par la validation depuis une commande (À préparer / Prêtes). *@

@if (Resultat != null)
{
    @if (Resultat.EstValide)
    {
        <RadzenStack Gap="1.25rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenIcon Icon="check_circle" Style="font-size: 2.5rem; color: var(--rz-success);" />
                <RadzenStack Gap="0">
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: var(--rz-success);">Code valide</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">La transaction est autorisée</RadzenText>
                </RadzenStack>
            </RadzenStack>

            <RadzenStack Gap="0.5rem">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                    <RadzenText Style="color: var(--rz-text-secondary-color);">Collaborateur</RadzenText>
                    <RadzenText Style="font-weight: 600;">@Resultat.PrenomCollaborateur @Resultat.NomCollaborateur</RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                    <RadzenText Style="color: var(--rz-text-secondary-color);">Entreprise</RadzenText>
                    <RadzenText Style="font-weight: 600;">@Resultat.NomEntreprise</RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                    <RadzenText Style="color: var(--rz-text-secondary-color);">N° Commande</RadzenText>
                    <RadzenText Style="font-weight: 600;">@Resultat.NumeroCommande</RadzenText>
                </RadzenStack>
                @if (Resultat.AchatsSupplementaires > 0)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                        <RadzenText Style="color: var(--rz-text-secondary-color);">Achats supplémentaires</RadzenText>
                        <RadzenText Style="font-weight: 600; color: var(--rz-success);">@Resultat.AchatsSupplementaires € HT</RadzenText>
                    </RadzenStack>
                }

                @if (!string.IsNullOrEmpty(Resultat.ListeMateriaux))
                {
                    <RadzenStack Gap="0.25rem" Style="margin-top: 0.5rem;">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Matériaux autorisés</RadzenText>
                        <RadzenCard Variant="Variant.Flat" Style="background: var(--rz-base-200); padding: 0.75rem;">
                            <RadzenText TextStyle="TextStyle.Body2" Style="@Services.H_TexteLibre.Style(Resultat.ListeMateriaux)"
                                        @onclick="@(() => VoirDetailSiTronque(Resultat.ListeMateriaux, "Matériaux autorisés"))">@Services.H_TexteLibre.Tronquer(Resultat.ListeMateriaux)</RadzenText>
                        </RadzenCard>
                        @if (Services.H_TexteLibre.EstTronque(Resultat.ListeMateriaux))
                        {
                            <RadzenButton Text="Voir le détail" Icon="unfold_more" ButtonStyle="ButtonStyle.Base"
                                          Variant="Variant.Text" Size="ButtonSize.Small" Style="align-self: flex-start;"
                                          Click="@(() => VoirDetail(Resultat.ListeMateriaux!, "Matériaux autorisés"))" />
                        }
                    </RadzenStack>
                }
                @if (!string.IsNullOrEmpty(Resultat.Info))
                {
                    <RadzenStack Gap="0.25rem" Style="margin-top: 0.5rem;">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Informations complémentaires</RadzenText>
                        <RadzenCard Variant="Variant.Flat" Style="background: var(--rz-base-200); padding: 0.75rem;">
                            <RadzenText TextStyle="TextStyle.Body2" Style="@Services.H_TexteLibre.Style(Resultat.Info)"
                                        @onclick="@(() => VoirDetailSiTronque(Resultat.Info, "Informations complémentaires"))">@Services.H_TexteLibre.Tronquer(Resultat.Info)</RadzenText>
                        </RadzenCard>
                        @if (Services.H_TexteLibre.EstTronque(Resultat.Info))
                        {
                            <RadzenButton Text="Voir le détail" Icon="unfold_more" ButtonStyle="ButtonStyle.Base"
                                          Variant="Variant.Text" Size="ButtonSize.Small" Style="align-self: flex-start;"
                                          Click="@(() => VoirDetail(Resultat.Info!, "Informations complémentaires"))" />
                        }
                    </RadzenStack>
                }
            </RadzenStack>

            @if (!string.IsNullOrEmpty(Resultat.PdfBase64))
            {
                <RadzenButton Text="Télécharger la confirmation PDF" Icon="picture_as_pdf"
                              ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                              Size="ButtonSize.Medium" Style="width: 100%;" Click="TelechargerPdf" />
            }
        </RadzenStack>
    }
    else
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <RadzenIcon Icon="cancel" Style="font-size: 2.5rem; color: var(--rz-danger);" />
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: var(--rz-danger);">Code invalide</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">@Resultat.Message</RadzenText>
            </RadzenStack>
        </RadzenStack>
    }
}

@code {
    [Parameter] public DTO_ResultatValidation? Resultat { get; set; }
    // Valeur du code saisi : sert uniquement à nommer le PDF téléchargé
    [Parameter] public string ValeurCode { get; set; } = string.Empty;

    private async Task TelechargerPdf()
    {
        if (Resultat == null || string.IsNullOrEmpty(Resultat.PdfBase64))
            return;

        var _nom = $"KEIDO_Confirmation_{ValeurCode}.pdf";
        await JS.InvokeVoidAsync("btpTelechargerFichier", Resultat.PdfBase64, _nom, "application/pdf");
    }

    private async Task VoirDetailSiTronque(string? p_texte, string p_titre)
    {
        if (Services.H_TexteLibre.EstTronque(p_texte))
        {
            await VoirDetail(p_texte!, p_titre);
        }
    }

    private async Task VoirDetail(string p_texte, string p_titre)
    {
        await Dialog.OpenAsync<Comp_DialogTexte>(p_titre,
            new Dictionary<string, object?> { ["Contenu"] = p_texte },
            new DialogOptions { Width = "520px", CloseDialogOnOverlayClick = true });
    }
}
