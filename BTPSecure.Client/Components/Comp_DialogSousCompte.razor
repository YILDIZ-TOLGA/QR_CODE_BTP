@inject DialogService Dialog

<RadzenTemplateForm TItem="DTO_CreerSousCompte" Data="_dto" Submit="Valider">
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
            Un mot de passe temporaire sera généré et envoyé par email au sous-compte.
        </RadzenText>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Nom" Variant="Variant.Outlined" Style="width: 100%;">
                    <Start><RadzenIcon Icon="badge" /></Start>
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_dto.Nom" Name="Nom" Style="width: 100%;" />
                    </ChildContent>
                    <Helper><RadzenRequiredValidator Component="Nom" Text="Obligatoire." /></Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Prénom" Variant="Variant.Outlined" Style="width: 100%;">
                    <Start><RadzenIcon Icon="person" /></Start>
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_dto.Prenom" Name="Prenom" Style="width: 100%;" />
                    </ChildContent>
                    <Helper><RadzenRequiredValidator Component="Prenom" Text="Obligatoire." /></Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width: 100%;">
            <Start><RadzenIcon Icon="mail" /></Start>
            <ChildContent>
                <RadzenTextBox @bind-Value="_dto.Email" Name="Email" Style="width: 100%;" />
            </ChildContent>
            <Helper>
                <RadzenRequiredValidator Component="Email" Text="Obligatoire." />
                <RadzenEmailValidator Component="Email" Text="Email invalide." />
            </Helper>
        </RadzenFormField>

        <RadzenFormField Text="Téléphone" Variant="Variant.Outlined" Style="width: 100%;">
            <Start><RadzenIcon Icon="phone" /></Start>
            <ChildContent>
                <RadzenTextBox @bind-Value="_dto.Telephone" Style="width: 100%;" Placeholder="Optionnel" />
            </ChildContent>
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Annuler" Variant="Variant.Outlined" Click="Annuler" />
            <RadzenButton Text="Créer" Icon="person_add" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private DTO_CreerSousCompte _dto = new();

    private void Valider()
    {
        Dialog.Close(_dto);
    }

    private void Annuler()
    {
        Dialog.Close(null);
    }
}
