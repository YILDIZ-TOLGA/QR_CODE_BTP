@inject DialogService Dialog

<RadzenStack Gap="1.5rem" Style="min-width: 400px;">
    <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">
        Entrez l'email du collaborateur déjà inscrit sur BTPSecure pour l'ajouter à votre entreprise.
    </RadzenText>

    <RadzenFormField Text="Email du collaborateur" Variant="Variant.Outlined" Style="width: 100%;">
        <Start>
            <RadzenIcon Icon="person_search" />
        </Start>
        <ChildContent>
            <RadzenTextBox @bind-Value="_email" Style="width: 100%;" Placeholder="collaborateur@email.com" />
        </ChildContent>
    </RadzenFormField>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.75rem">
        <RadzenButton Text="Annuler" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="() => Dialog.Close()" />
        <RadzenButton Text="Ajouter" ButtonStyle="ButtonStyle.Primary" Icon="person_add"
                      Click="Valider" Disabled="@string.IsNullOrWhiteSpace(_email)" />
    </RadzenStack>
</RadzenStack>

@code {
    private string _email = string.Empty;

    private void Valider()
    {
        Dialog.Close(_email.Trim());
    }
}
