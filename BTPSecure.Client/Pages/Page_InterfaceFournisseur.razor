@page "/fournisseur"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Fournisseur")]
@inject Services.S_Code SCode
@inject NotificationService Notification

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1.5rem;">
    <RadzenIcon Icon="verified_user" Style="font-size: 2rem; color: var(--rz-primary);" />
    <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Accueil</RadzenText>
</RadzenStack>

<RadzenRow JustifyContent="JustifyContent.Center">
    <RadzenColumn Size="12" SizeMD="8" SizeLG="6">

        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Gap="1.25rem">
                <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">
                    Saisissez le code d'autorisation présenté par le collaborateur pour vérifier sa validité.
                </RadzenText>

                <RadzenFormField Text="Code d'autorisation" Variant="Variant.Outlined" Style="width: 100%;">
                    <Start><RadzenIcon Icon="key" /></Start>
                    <ChildContent>
                        <RadzenTextBox Value="@_valeurCode" @oninput="MajValeurCode"
                                       Style="width: 100%; font-family: monospace; font-size: 1.3rem; text-transform: uppercase; letter-spacing: 2px;"
                                       Placeholder="XXXX-XXXX" MaxLength="9" />
                    </ChildContent>
                </RadzenFormField>

                <RadzenButton Text="Vérifier le code" Icon="search" ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Large" Style="width: 100%;" Click="Valider" IsBusy="_enChargement"
                              Disabled="@(string.IsNullOrWhiteSpace(_valeurCode))" />
            </RadzenStack>
        </RadzenCard>

        @if (_resultat != null)
        {
            <RadzenCard Variant="Variant.Outlined" Style="margin-top: 1.5rem;">
                <Comp_ResultatValidation Resultat="_resultat" ValeurCode="@_valeurCode" />
            </RadzenCard>
        }
    </RadzenColumn>
</RadzenRow>

@code {
    private string _valeurCode = string.Empty;
    private DTO_ResultatValidation? _resultat;
    private bool _enChargement;

    private async Task Valider()
    {
        _enChargement = true;
        _resultat = null;

        var (_succes, _res) = await SCode.Valider(_valeurCode.Trim().ToUpper());
        _resultat = _res;
        _enChargement = false;

        if (!_succes)
        {
            var _message = "Code invalide.";
            if (_resultat != null && !string.IsNullOrEmpty(_resultat.Message))
                _message = _resultat.Message;
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    // Le « - » du format XXXX-XXXX est inséré automatiquement pendant la frappe
    private void MajValeurCode(ChangeEventArgs p_e)
    {
        var _saisie = "";
        if (p_e.Value != null)
        {
            var _s = p_e.Value.ToString();
            if (_s != null)
                _saisie = _s;
        }
        _valeurCode = Services.H_Code.Formater(_saisie);
    }
}
