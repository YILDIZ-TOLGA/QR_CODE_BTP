@page "/fournisseur"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Fournisseur")]
@implements IDisposable
@inject Services.S_Code SCode
@inject NotificationService Notification
@inject DialogService Dialog
@inject IJSRuntime JS

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1.5rem;">
    <RadzenIcon Icon="verified_user" Style="font-size: 2rem; color: var(--rz-primary);" />
    <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Accueil</RadzenText>
</RadzenStack>

<RadzenRow JustifyContent="JustifyContent.Center">
    <RadzenColumn Size="12" SizeMD="8" SizeLG="6">

        <!-- Zone de saisie du code (tout en haut) -->
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Gap="1.25rem">
                <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">
                    Saisissez le code d'autorisation présenté par le collaborateur pour vérifier sa validité.
                </RadzenText>

                <RadzenFormField Text="Code d'autorisation" Variant="Variant.Outlined" Style="width: 100%;">
                    <Start><RadzenIcon Icon="key" /></Start>
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_valeurCode"
                                       Style="width: 100%; font-family: monospace; font-size: 1.3rem; text-transform: uppercase; letter-spacing: 2px;"
                                       Placeholder="XXXX-XXXX" MaxLength="9" />
                    </ChildContent>
                </RadzenFormField>

                <RadzenButton Text="Vérifier le code" Icon="search" ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Large" Style="width: 100%;" Click="Valider" IsBusy="_enChargement"
                              Disabled="@(string.IsNullOrWhiteSpace(_valeurCode))" />
            </RadzenStack>
        </RadzenCard>

        @if (_resultat != null)
        {
            <RadzenCard Variant="Variant.Outlined" Style="margin-top: 1.5rem;">
                @if (_resultat.EstValide)
                {
                    <RadzenStack Gap="1.25rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <RadzenIcon Icon="check_circle" Style="font-size: 2.5rem; color: var(--rz-success);" />
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: var(--rz-success);">Code valide</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">La transaction est autorisée</RadzenText>
                            </RadzenStack>
                        </RadzenStack>

                        <RadzenStack Gap="0.5rem">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenText Style="color: var(--rz-text-secondary-color);">Collaborateur</RadzenText>
                                <RadzenText Style="font-weight: 600;">@_resultat.PrenomCollaborateur @_resultat.NomCollaborateur</RadzenText>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenText Style="color: var(--rz-text-secondary-color);">Entreprise</RadzenText>
                                <RadzenText Style="font-weight: 600;">@_resultat.NomEntreprise</RadzenText>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenText Style="color: var(--rz-text-secondary-color);">N° Commande</RadzenText>
                                <RadzenText Style="font-weight: 600;">@_resultat.NumeroCommande</RadzenText>
                            </RadzenStack>
                            @if (_resultat.AchatsSupplementaires > 0)
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenText Style="color: var(--rz-text-secondary-color);">Achats supplémentaires</RadzenText>
                                    <RadzenText Style="font-weight: 600; color: var(--rz-success);">@_resultat.AchatsSupplementaires € HT</RadzenText>
                                </RadzenStack>
                            }

                            @if (!string.IsNullOrEmpty(_resultat.ListeMateriaux))
                            {
                                <RadzenStack Gap="0.25rem" Style="margin-top: 0.5rem;">
                                    <RadzenText TextStyle="TextStyle.Subtitle2">Matériaux autorisés</RadzenText>
                                    <RadzenCard Variant="Variant.Flat" Style="background: var(--rz-base-200); padding: 0.75rem;">
                                        <RadzenText TextStyle="TextStyle.Body2" Style="white-space: pre-wrap;">@_resultat.ListeMateriaux</RadzenText>
                                    </RadzenCard>
                                </RadzenStack>
                            }
                            @if (!string.IsNullOrEmpty(_resultat.Info))
                            {
                                <RadzenStack Gap="0.25rem" Style="margin-top: 0.5rem;">
                                    <RadzenText TextStyle="TextStyle.Subtitle2">Informations complémentaires</RadzenText>
                                    <RadzenCard Variant="Variant.Flat" Style="background: var(--rz-base-200); padding: 0.75rem;">
                                        <RadzenText TextStyle="TextStyle.Body2" Style="white-space: pre-wrap;">@_resultat.Info</RadzenText>
                                    </RadzenCard>
                                </RadzenStack>
                            }
                        </RadzenStack>

                        @if (!string.IsNullOrEmpty(_resultat.PdfBase64))
                        {
                            <RadzenButton Text="Télécharger la confirmation PDF" Icon="picture_as_pdf"
                                          ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                                          Size="ButtonSize.Medium" Style="width: 100%;" Click="TelechargerPdf" />
                        }
                    </RadzenStack>
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                        <RadzenIcon Icon="cancel" Style="font-size: 2.5rem; color: var(--rz-danger);" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: var(--rz-danger);">Code invalide</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">@_resultat.Message</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                }
            </RadzenCard>
        }

        <!-- Commandes -->
        @if (_commandes.Count > 0)
        {
            <RadzenCard Variant="Variant.Outlined" Style="margin-top: 1.5rem;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem" Style="margin-bottom: 1rem;">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenIcon Icon="local_shipping" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Commandes</RadzenText>
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@_commandesFiltrees.Count.ToString()" IsPill="true" />
                    </RadzenStack>
                    <RadzenSelectBar @bind-Value="_filtreCommandes" TValue="string" Size="ButtonSize.Small">
                        <Items>
                            <RadzenSelectBarItem Text="Toutes" Value="@("toutes")" />
                            <RadzenSelectBarItem Text="À préparer" Value="@("apreparer")" />
                            <RadzenSelectBarItem Text="Prêtes" Value="@("pretes")" />
                        </Items>
                    </RadzenSelectBar>
                </RadzenStack>

                @if (_commandesFiltrees.Count == 0)
                {
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 1.5rem 0;">
                        <RadzenIcon Icon="inbox" Style="font-size: 2rem; color: var(--rz-text-disabled-color);" />
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">Aucune commande dans cette catégorie</RadzenText>
                    </RadzenStack>
                }
                else
                {
                    <RadzenStack Gap="1rem">
                        @foreach (var _cmd in _commandesFiltrees)
                        {
                            <RadzenCard Variant="Variant.Filled" Style="background: var(--rz-base-100); padding: 1rem;">
                                <RadzenStack Gap="0.6rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="min-width: 0; flex: 1;">
                                            <RadzenIcon Icon="business" Style="color: var(--rz-primary);" />
                                            <RadzenText Style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@_cmd.NomEntrepriseDirigeant</RadzenText>
                                        </RadzenStack>
                                        <RadzenBadge BadgeStyle="@(_cmd.TypeCode == Enum_TypeCode.LibreService ? BadgeStyle.Info : BadgeStyle.Warning)"
                                                     Text="@Services.H_TypeCode.Libelle(_cmd.TypeCode)" IsPill="true" />
                                    </RadzenStack>

                                    <RadzenStack Gap="0.25rem">
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Référence</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body2" Style="font-family: monospace; font-weight: 600;">@_cmd.Reference</RadzenText>
                                    </RadzenStack>

                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="receipt_long" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Commande : @_cmd.NumeroCommande</RadzenText>
                                    </RadzenStack>

                                    @if (_cmd.DateExpiration.HasValue)
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="schedule" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                Expire le @_cmd.DateExpiration.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </RadzenText>
                                        </RadzenStack>
                                    }

                                    @if (!string.IsNullOrEmpty(_cmd.ListeMateriaux))
                                    {
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Matériaux</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body2" Style="white-space: pre-wrap;">@Tronquer(_cmd.ListeMateriaux)</RadzenText>
                                            @if (_cmd.ListeMateriaux.Length > SEUIL_TRONCATURE)
                                            {
                                                <RadzenButton Text="Voir le détail" Icon="unfold_more" ButtonStyle="ButtonStyle.Base"
                                                              Variant="Variant.Text" Size="ButtonSize.Small"
                                                              Click="() => VoirDetail(_cmd.ListeMateriaux)" />
                                            }
                                        </RadzenStack>
                                    }

                                    @if (_cmd.AchatsSupplementaires > 0)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@($"Achats supplémentaires : {_cmd.AchatsSupplementaires} € HT")" IsPill="true" />
                                    }

                                    @if (!string.IsNullOrEmpty(_cmd.Info))
                                    {
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Info</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body2" Style="white-space: pre-wrap;">@_cmd.Info</RadzenText>
                                        </RadzenStack>
                                    }

                                    @if (_cmd.EstPrete)
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="task_alt" Style="color: var(--rz-success);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-success); font-weight: 600;">
                                                Commande marquée prête le @_cmd.DatePrete?.ToLocalTime().ToString("dd/MM HH:mm")
                                            </RadzenText>
                                        </RadzenStack>
                                    }
                                    else
                                    {
                                        <RadzenButton Text="Commande prête" Icon="task_alt" ButtonStyle="ButtonStyle.Info"
                                                      Variant="Variant.Outlined" Size="ButtonSize.Small"
                                                      Click="() => MarquerPrete(_cmd.CodeId)" />
                                    }

                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End">
                                        <RadzenFormField Text="Code à saisir" Variant="Variant.Outlined" Style="flex: 1;">
                                            <Start><RadzenIcon Icon="key" /></Start>
                                            <ChildContent>
                                                <RadzenTextBox @bind-Value="_codesSaisis[_cmd.CodeId]"
                                                               Style="width: 100%; font-family: monospace; text-transform: uppercase; letter-spacing: 2px;"
                                                               Placeholder="XXXX-XXXX" MaxLength="9" />
                                            </ChildContent>
                                        </RadzenFormField>
                                        <RadzenButton Text="Valider" Icon="check" ButtonStyle="ButtonStyle.Success"
                                                      Click="() => ValiderCommande(_cmd.CodeId)"
                                                      Disabled="@(string.IsNullOrWhiteSpace(ObtenirCodeSaisi(_cmd.CodeId)))" />
                                    </RadzenStack>
                                </RadzenStack>
                            </RadzenCard>
                        }
                    </RadzenStack>
                }
            </RadzenCard>
        }
    </RadzenColumn>
</RadzenRow>

@code {
    private string _valeurCode = string.Empty;
    private DTO_ResultatValidation? _resultat;
    private bool _enChargement;
    private List<DTO_CommandeAVenir> _commandes = new();
    private Dictionary<int, string> _codesSaisis = new();
    private string _filtreCommandes = "toutes";

    private const int SEUIL_TRONCATURE = 140;

    private List<DTO_CommandeAVenir> _commandesFiltrees
    {
        get
        {
            if (_filtreCommandes == "apreparer")
            {
                return _commandes.Where(c => !c.EstPrete).ToList();
            }
            if (_filtreCommandes == "pretes")
            {
                return _commandes.Where(c => c.EstPrete).ToList();
            }
            return _commandes;
        }
    }

    private static string Tronquer(string p_texte)
    {
        if (p_texte.Length <= SEUIL_TRONCATURE)
        {
            return p_texte;
        }
        return p_texte.Substring(0, SEUIL_TRONCATURE) + "…";
    }

    private async Task VoirDetail(string p_texte)
    {
        await Dialog.OpenAsync<Comp_DialogTexte>("Détail des matériaux",
            new Dictionary<string, object?> { ["Contenu"] = p_texte },
            new DialogOptions { Width = "520px", CloseDialogOnOverlayClick = true });
    }

    private System.Timers.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await ChargerCommandes();

        _timer = new System.Timers.Timer(15000);
        _timer.Elapsed += async (_, _) => await RafraichirSilencieux();
        _timer.AutoReset = true;
        _timer.Start();
    }

    private async Task RafraichirSilencieux()
    {
        try
        {
            await ChargerCommandes();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }

    private async Task ChargerCommandes()
    {
        _commandes = await SCode.ObtenirCommandesAVenir();
        foreach (var _c in _commandes)
        {
            if (!_codesSaisis.ContainsKey(_c.CodeId))
                _codesSaisis[_c.CodeId] = string.Empty;
        }
    }

    private string ObtenirCodeSaisi(int p_codeId)
    {
        if (_codesSaisis.TryGetValue(p_codeId, out var _val))
            return _val;
        return string.Empty;
    }

    private async Task MarquerPrete(int p_codeId)
    {
        var (_succes, _message) = await SCode.MarquerPrete(p_codeId);
        if (_succes)
        {
            Notification.Notify(NotificationSeverity.Success, "Succès", "Le dirigeant a été notifié.");
            await ChargerCommandes();
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private async Task ValiderCommande(int p_codeId)
    {
        var _val = ObtenirCodeSaisi(p_codeId);
        if (string.IsNullOrWhiteSpace(_val))
            return;

        var (_succes, _res) = await SCode.ValiderPourCommande(p_codeId, _val.Trim().ToUpper());
        _resultat = _res;

        if (_succes)
        {
            Notification.Notify(NotificationSeverity.Success, "Succès", "Code validé.");
            _codesSaisis.Remove(p_codeId);
            await ChargerCommandes();
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", _resultat?.Message ?? "Code invalide.");
        }
    }

    private async Task Valider()
    {
        _enChargement = true;
        _resultat = null;

        var (_succes, _res) = await SCode.Valider(_valeurCode.Trim().ToUpper());
        _resultat = _res;
        _enChargement = false;

        if (_succes)
        {
            await ChargerCommandes();
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", _resultat?.Message ?? "Code invalide.");
        }
    }

    private async Task TelechargerPdf()
    {
        if (_resultat?.PdfBase64 == null) return;
        var _nom = $"BTPSecure_Confirmation_{_valeurCode}.pdf";
        await JS.InvokeVoidAsync("eval", $@"
            var a = document.createElement('a');
            a.href = 'data:application/pdf;base64,{_resultat.PdfBase64}';
            a.download = '{_nom}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ");
    }
}
