@page "/fournisseur"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Fournisseur")]
@inject Services.S_Code SCode
@inject NotificationService Notification
@inject IJSRuntime JS

<RadzenText TextStyle="TextStyle.H4">Validation de code</RadzenText>

<RadzenRow JustifyContent="JustifyContent.Center" Style="margin-top:1rem;">
    <RadzenColumn Size="12" SizeMD="8" SizeLG="6">
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="Code d'autorisation" Style="width:100%;">
                    <RadzenTextBox @bind-Value="_valeurCode" Style="width:100%; font-family:monospace; font-size:1.2rem; text-transform:uppercase;"
                                   Placeholder="XXXX-XXXX" MaxLength="9" />
                </RadzenFormField>
                <RadzenButton Text="Valider le code" Icon="verified" ButtonStyle="ButtonStyle.Primary"
                              Style="width:100%;" Click="Valider" IsBusy="_enChargement"
                              Disabled="@(string.IsNullOrWhiteSpace(_valeurCode))" />
            </RadzenStack>
        </RadzenCard>

        @if (_resultat != null)
        {
            <RadzenCard Style="margin-top:1rem;">
                @if (_resultat.EstValide)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Title="Code valide">
                        Le code a été validé avec succès.
                    </RadzenAlert>
                    <RadzenStack Gap="0.5rem" Style="margin-top:1rem;">
                        <RadzenText TextStyle="TextStyle.Body1"><strong>Salarié :</strong> @_resultat.PrenomSalarie @_resultat.NomSalarie</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1"><strong>N° Commande :</strong> @_resultat.NumeroCommande</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1"><strong>Entreprise :</strong> @_resultat.NomEntreprise</RadzenText>
                        @if (!string.IsNullOrEmpty(_resultat.ListeMateriaux))
                        {
                            <RadzenText TextStyle="TextStyle.Body1"><strong>Matériaux :</strong></RadzenText>
                            <RadzenCard Style="background:#f5f5f5;">
                                <RadzenText>@_resultat.ListeMateriaux</RadzenText>
                            </RadzenCard>
                        }
                        @if (!string.IsNullOrEmpty(_resultat.PdfBase64))
                        {
                            <RadzenButton Text="Télécharger le PDF" Icon="download" ButtonStyle="ButtonStyle.Secondary"
                                          Click="TelechargerPdf" Style="margin-top:0.5rem;" />
                        }
                    </RadzenStack>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Title="Code invalide">
                        @_resultat.Message
                    </RadzenAlert>
                }
            </RadzenCard>
        }
    </RadzenColumn>
</RadzenRow>

@code {
    private string _valeurCode = string.Empty;
    private DTO_ResultatValidation? _resultat;
    private bool _enChargement;

    private async Task Valider()
    {
        _enChargement = true;
        _resultat = null;

        var (_succes, _res) = await SCode.Valider(_valeurCode.Trim().ToUpper());
        _resultat = _res;
        _enChargement = false;

        if (!_succes)
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", _resultat?.Message ?? "Code invalide.");
        }
    }

    private async Task TelechargerPdf()
    {
        if (_resultat?.PdfBase64 == null) return;
        var _nom = $"BTPSecure_Confirmation_{_valeurCode}.pdf";
        await JS.InvokeVoidAsync("eval", $@"
            var a = document.createElement('a');
            a.href = 'data:application/pdf;base64,{_resultat.PdfBase64}';
            a.download = '{_nom}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ");
    }
}
