@page "/fournisseur/a-preparer"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Fournisseur")]
@implements IDisposable
@inject Services.S_Code SCode

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1.5rem;">
    <RadzenIcon Icon="pending_actions" Style="font-size: 2rem; color: var(--rz-primary);" />
    <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Commandes à préparer</RadzenText>
    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@_commandes.Count.ToString()" IsPill="true" />
</RadzenStack>

@if (_chargement)
{
    <RadzenRow JustifyContent="JustifyContent.Center" Style="margin-top: 4rem;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
    </RadzenRow>
}
else
{
    <RadzenRow JustifyContent="JustifyContent.Center">
        <RadzenColumn Size="12" SizeMD="9" SizeLG="7">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color); margin-bottom: 1rem;">
                    Commandes dont la notification « prête » n'a pas encore été envoyée.
                </RadzenText>
                <Comp_ListeCommandes Commandes="_commandes" OnAction="Recharger" />
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
}

@code {
    private List<DTO_CommandeAVenir> _commandes = new();
    private bool _chargement = true;
    private System.Timers.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await Recharger();
        _chargement = false;

        _timer = new System.Timers.Timer(15000);
        _timer.Elapsed += async (_, _) => { await Recharger(); await InvokeAsync(StateHasChanged); };
        _timer.AutoReset = true;
        _timer.Start();
    }

    private async Task Recharger()
    {
        var _toutes = await SCode.ObtenirCommandesAVenir();
        _commandes = _toutes.Where(c => !c.EstPrete).ToList();
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}
