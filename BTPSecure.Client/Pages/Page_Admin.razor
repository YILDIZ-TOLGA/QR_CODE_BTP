@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@implements IDisposable
@inject Services.S_Admin SAdmin
@inject NotificationService Notification
@inject DialogService Dialog

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1.5rem;">
    <RadzenIcon Icon="admin_panel_settings" Style="font-size: 2rem; color: var(--rz-primary);" />
    <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Administration</RadzenText>
</RadzenStack>

@if (_chargement)
{
    <RadzenRow JustifyContent="JustifyContent.Center" Style="margin-top: 4rem;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
    </RadzenRow>
}
else if (_entreprises.Count == 0)
{
    <RadzenCard Variant="Variant.Outlined">
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 3rem 0;">
            <RadzenIcon Icon="domain_disabled" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
            <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-text-secondary-color);">
                Aucune entreprise enregistrée
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                Les entreprises apparaîtront ici une fois créées par les dirigeants.
            </RadzenText>
        </RadzenStack>
    </RadzenCard>
}
else
{
    <RadzenStack Gap="1.5rem">
        <!-- Stats rapides -->
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenIcon Icon="business" Style="font-size: 2.5rem; color: var(--rz-primary);" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@_entreprises.Count</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Entreprises</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenIcon Icon="check_circle" Style="font-size: 2.5rem; color: var(--rz-success);" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@_entreprises.Count(e => e.EstAutorisee)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Autorisées</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenIcon Icon="block" Style="font-size: 2.5rem; color: var(--rz-danger);" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@_entreprises.Count(e => !e.EstAutorisee)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">En attente</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <!-- Liste des entreprises -->
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1rem;">
                <RadzenIcon Icon="list_alt" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Gestion des entreprises</RadzenText>
            </RadzenStack>

            <RadzenRow Gap="1rem">
                @foreach (var _ent in _entreprises)
                {
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                        <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                            <RadzenStack Gap="0.75rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="min-width: 0; flex: 1;">
                                        <RadzenIcon Icon="business" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                                        <RadzenText Style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@_ent.Nom</RadzenText>
                                    </RadzenStack>
                                    @if (_ent.EstAutorisee)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Autorisée" IsPill="true" />
                                    }
                                    else
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="En attente" IsPill="true" />
                                    }
                                </RadzenStack>

                                <RadzenStack Gap="0.4rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="person" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                        <RadzenText TextStyle="TextStyle.Body2">@_ent.PrenomPatron @_ent.NomPatron</RadzenText>
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="mail" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); overflow: hidden; text-overflow: ellipsis;">@_ent.EmailPatron</RadzenText>
                                    </RadzenStack>
                                    @if (!string.IsNullOrEmpty(_ent.Siret))
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="pin" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">SIRET : @_ent.Siret</RadzenText>
                                        </RadzenStack>
                                    }
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="event" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Créée le @_ent.DateCreation.ToLocalTime().ToString("dd/MM/yyyy")</RadzenText>
                                    </RadzenStack>
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{_ent.NombreSalaries} collaborateur(s)")" IsPill="true" />
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@($"{_ent.NombreCodes} code(s)")" IsPill="true" />
                                </RadzenStack>

                                @if (_ent.EstAutorisee)
                                {
                                    <RadzenButton Text="Bloquer" Icon="block" ButtonStyle="ButtonStyle.Danger"
                                                  Variant="Variant.Outlined" Size="ButtonSize.Small" Style="width: 100%;"
                                                  Click="() => Basculer(_ent)" />
                                }
                                else
                                {
                                    <RadzenButton Text="Autoriser" Icon="check_circle" ButtonStyle="ButtonStyle.Success"
                                                  Variant="Variant.Flat" Size="ButtonSize.Small" Style="width: 100%;"
                                                  Click="() => Basculer(_ent)" />
                                }
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>
        </RadzenCard>
    </RadzenStack>
}

@code {
    private List<DTO_EntrepriseAdmin> _entreprises = new();
    private bool _chargement = true;

    private System.Timers.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        _entreprises = await SAdmin.ObtenirEntreprises();
        _chargement = false;

        _timer = new System.Timers.Timer(15000);
        _timer.Elapsed += async (_, _) => await RafraichirSilencieux();
        _timer.AutoReset = true;
        _timer.Start();
    }

    private async Task RafraichirSilencieux()
    {
        try
        {
            _entreprises = await SAdmin.ObtenirEntreprises();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }

    private async Task Basculer(DTO_EntrepriseAdmin p_entreprise)
    {
        try
        {
            var _estAutorisee = p_entreprise.EstAutorisee;
            string _texteAction;
            if (_estAutorisee)
            {
                _texteAction = "Bloquer";
            }
            else
            {
                _texteAction = "Autoriser";
            }
            var _confirm = await Dialog.Confirm(
                $"Voulez-vous {_texteAction.ToLower()} l'entreprise « {p_entreprise.Nom} » ?",
                "Confirmation",
                new ConfirmOptions { OkButtonText = _texteAction, CancelButtonText = "Annuler" });

            if (_confirm == true)
            {
                var (_succes, _message) = await SAdmin.BasculerAutorisation(p_entreprise.Id);
                if (_succes)
                {
                    Notification.Notify(NotificationSeverity.Success, "Succès", _message);
                    _entreprises = await SAdmin.ObtenirEntreprises();
                    StateHasChanged();
                }
                else
                    Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
            }
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
    }
}
