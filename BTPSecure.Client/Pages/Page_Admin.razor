@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject Services.S_Admin SAdmin
@inject NotificationService Notification
@inject DialogService Dialog
@inject Services.S_Apporteur SApporteur

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom: 1.5rem;">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenIcon Icon="admin_panel_settings" Style="font-size: 2rem; color: var(--rz-primary);" />
        <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Administration</RadzenText>
    </RadzenStack>
    <Comp_AutoRefresh OnRefresh="RafraichirUi" />
</RadzenStack>

@if (_chargement)
{
    <RadzenRow JustifyContent="JustifyContent.Center" Style="margin-top: 4rem;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
    </RadzenRow>
}
else if (_entreprises.Count == 0)
{
    <RadzenCard Variant="Variant.Outlined">
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 3rem 0;">
            <RadzenIcon Icon="domain_disabled" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
            <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-text-secondary-color);">
                Aucune entreprise enregistrée
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                Les entreprises apparaîtront ici une fois créées par les dirigeants.
            </RadzenText>
        </RadzenStack>
    </RadzenCard>
}
else
{
    <RadzenStack Gap="1.5rem">
        <!-- Stats rapides -->
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenIcon Icon="business" Style="font-size: 2.5rem; color: var(--rz-primary);" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@_entreprises.Count</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Entreprises</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenIcon Icon="check_circle" Style="font-size: 2.5rem; color: var(--rz-success);" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@_entreprises.Count(e => e.EstAutorisee)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Autorisées</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenIcon Icon="block" Style="font-size: 2.5rem; color: var(--rz-danger);" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@_entreprises.Count(e => !e.EstAutorisee)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">En attente</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <!-- Liste des entreprises -->
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1rem;">
                <RadzenIcon Icon="list_alt" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Gestion des entreprises</RadzenText>
            </RadzenStack>

            <RadzenRow Gap="1rem">
                @foreach (var _ent in _entreprises)
                {
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                        <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                            <RadzenStack Gap="0.75rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="min-width: 0; flex: 1;">
                                        <RadzenIcon Icon="business" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                                        <RadzenText Style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@_ent.Nom</RadzenText>
                                    </RadzenStack>
                                    @if (_ent.EstAutorisee)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Autorisée" IsPill="true" />
                                    }
                                    else
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="En attente" IsPill="true" />
                                    }
                                </RadzenStack>

                                <RadzenStack Gap="0.4rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="person" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                        <RadzenText TextStyle="TextStyle.Body2">@_ent.PrenomDirigeant @_ent.NomDirigeant</RadzenText>
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="mail" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); overflow: hidden; text-overflow: ellipsis;">@_ent.EmailDirigeant</RadzenText>
                                    </RadzenStack>
                                    @if (!string.IsNullOrEmpty(_ent.Siret))
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="pin" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">SIRET : @_ent.Siret</RadzenText>
                                        </RadzenStack>
                                    }
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="event" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Créée le @_ent.DateCreation.ToLocalTime().ToString("dd/MM/yyyy")</RadzenText>
                                    </RadzenStack>
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{_ent.NombreCollaborateurs} collaborateur(s)")" IsPill="true" />
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@($"{_ent.NombreCodes} code(s)")" IsPill="true" />
                                </RadzenStack>

                                @* Parrainage : l'admin doit le voir AVANT de cliquer sur Autoriser *@
                                @if (_ent.EstParrainee)
                                {
                                    <RadzenStack Gap="0.25rem" Style="border-left: 3px solid var(--rz-primary); padding-left: 0.6rem;">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem" Wrap="FlexWrap.Wrap">
                                            <RadzenIcon Icon="handshake" Style="font-size: 1rem; color: var(--rz-primary);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="font-weight: 600;">Parrainée</RadzenText>
                                            <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="@_ent.CodeParrainageUtilise" IsPill="true" />
                                        </RadzenStack>
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                            Apporteur : @_ent.NomApporteur
                                        </RadzenText>
                                        @if (_ent.ParrainageDejaValide)
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                Commission fixée : @_ent.MontantCommission.ToString("0.##") €
                                            </RadzenText>
                                        }
                                        else
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-warning-dark);">
                                                Commission à fixer en autorisant
                                            </RadzenText>
                                        }
                                    </RadzenStack>
                                }

                                @* Plafond commun Responsable + Responsable Admin *@
                                <RadzenButton Text="@($"Limite responsables : {_ent.NombreResponsables} / {_ent.LimiteResponsables}")" Icon="shield"
                                              ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                              Style="width: 100%;" Click="() => ChangerLimiteResponsables(_ent)" />

                                @if (_ent.EstAutorisee)
                                {
                                    <RadzenButton Text="Bloquer" Icon="block" ButtonStyle="ButtonStyle.Danger"
                                                  Variant="Variant.Outlined" Size="ButtonSize.Small" Style="width: 100%;"
                                                  Click="() => Basculer(_ent)" />
                                }
                                else
                                {
                                    <RadzenButton Text="Autoriser" Icon="check_circle" ButtonStyle="ButtonStyle.Success"
                                                  Variant="Variant.Flat" Size="ButtonSize.Small" Style="width: 100%;"
                                                  Click="() => Basculer(_ent)" />
                                }
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>
        </RadzenCard>
    </RadzenStack>
}

@if (!_chargement)
{
    <RadzenCard Variant="Variant.Outlined" Style="margin-top: 1.5rem;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1rem;">
            <RadzenIcon Icon="local_shipping" Style="font-size: 1.5rem; color: var(--rz-primary);" />
            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Fournisseurs</RadzenText>
            @if (_fournisseurs.Count(f => !f.EstValide && f.EstActif) > 0)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@($"{_fournisseurs.Count(f => !f.EstValide && f.EstActif)} en attente")" IsPill="true" />
            }
        </RadzenStack>

        @if (_fournisseurs.Count == 0)
        {
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 2rem 0;">
                <RadzenIcon Icon="no_accounts" Style="font-size: 2.5rem; color: var(--rz-text-disabled-color);" />
                <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">Aucun fournisseur inscrit</RadzenText>
            </RadzenStack>
        }
        else
        {
            <RadzenRow Gap="1rem">
                @foreach (var _f in _fournisseurs)
                {
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                        <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                            <RadzenStack Gap="0.75rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="min-width: 0; flex: 1;">
                                        <RadzenIcon Icon="local_shipping" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                                        <RadzenText Style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@_f.Prenom @_f.Nom</RadzenText>
                                    </RadzenStack>
                                    @if (!_f.EstActif)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Bloqué" IsPill="true" />
                                    }
                                    else if (_f.EstValide)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Validé" IsPill="true" />
                                    }
                                    else
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="En attente" IsPill="true" />
                                    }
                                </RadzenStack>

                                <RadzenStack Gap="0.4rem">
                                    @if (!string.IsNullOrEmpty(_f.NomSociete))
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="business" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); overflow: hidden; text-overflow: ellipsis;">@_f.NomSociete</RadzenText>
                                        </RadzenStack>
                                    }
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="mail" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); overflow: hidden; text-overflow: ellipsis;">@_f.Email</RadzenText>
                                    </RadzenStack>
                                    @if (!string.IsNullOrEmpty(_f.Siret))
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="pin" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); font-family: monospace;">SIRET : @_f.Siret</RadzenText>
                                        </RadzenStack>
                                    }
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="event" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Inscrit le @_f.DateCreation.ToLocalTime().ToString("dd/MM/yyyy")</RadzenText>
                                    </RadzenStack>
                                </RadzenStack>

                                @if (_f.EstSousCompte)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Sous-compte" IsPill="true" />
                                        @if (!string.IsNullOrEmpty(_f.NomParent))
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">de @_f.NomParent</RadzenText>
                                        }
                                    </RadzenStack>
                                }
                                else
                                {
                                    @* La limite de sous-comptes se règle uniquement sur les comptes principaux *@
                                    <RadzenButton Text="@($"Limite sous-comptes : {_f.LimiteSousComptes}")" Icon="group"
                                                  ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                                  Style="width: 100%;" Click="() => ChangerLimite(_f)" />
                                }

                                @if (_f.EstSousCompte && _f.ParentBloque && !_f.EstActif)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                        Bloqué avec son compte principal : débloquez d'abord celui-ci.
                                    </RadzenText>
                                }

                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    @if (!_f.EstValide && _f.EstActif)
                                    {
                                        <RadzenButton Text="Valider" Icon="check_circle" ButtonStyle="ButtonStyle.Success"
                                                      Variant="Variant.Flat" Size="ButtonSize.Small" Style="flex: 1;"
                                                      Click="() => ValiderFournisseur(_f)" />
                                    }
                                    @if (_f.EstActif)
                                    {
                                        <RadzenButton Text="Bloquer" Icon="block" ButtonStyle="ButtonStyle.Danger"
                                                      Variant="Variant.Outlined" Size="ButtonSize.Small" Style="flex: 1;"
                                                      Click="() => BasculerBlocage(_f)" />
                                    }
                                    else
                                    {
                                        <RadzenButton Text="Débloquer" Icon="lock_open" ButtonStyle="ButtonStyle.Success"
                                                      Variant="Variant.Outlined" Size="ButtonSize.Small" Style="flex: 1;"
                                                      Disabled="@(_f.EstSousCompte && _f.ParentBloque)"
                                                      Click="() => BasculerBlocage(_f)" />
                                    }
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>
        }
    </RadzenCard>
}

@* Apporteurs d'affaires : de quoi savoir qui payer, et combien *@
@if (!_chargement)
{
    <RadzenCard Variant="Variant.Outlined" Style="margin-top: 1.5rem;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1rem;">
            <RadzenIcon Icon="handshake" Style="font-size: 1.5rem; color: var(--rz-primary);" />
            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Apporteurs d'affaires</RadzenText>
            @if (_apporteurs.Count > 0)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@_apporteurs.Count.ToString()" IsPill="true" />
            }
        </RadzenStack>

        @if (_apporteurs.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                Aucun apporteur d'affaires inscrit.
            </RadzenText>
        }
        else
        {
            <RadzenStack Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                    Le cumul ne compte que les parrainages validés. Un parrainage en attente
                    devient payable quand vous autorisez l'entreprise du filleul.
                </RadzenText>

                <RadzenRow Gap="1rem">
                    @foreach (var _a in _apporteurs)
                    {
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                                <RadzenStack Gap="0.6rem">

                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">@_a.Prenom @_a.Nom</RadzenText>
                                        <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="@_a.CodeParrainage" IsPill="true" />
                                    </RadzenStack>

                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">@_a.Email</RadzenText>

                                    @if (!_a.EstActif)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Compte bloqué" IsPill="true" />
                                    }

                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.4rem" Wrap="FlexWrap.Wrap">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@($"{_a.NombreFilleuls} filleul(s)")" IsPill="true" />
                                        @if (_a.NombreEnAttente > 0)
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@($"{_a.NombreEnAttente} en attente")" IsPill="true" />
                                        }
                                    </RadzenStack>

                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                        <RadzenIcon Icon="euro" Style="font-size: 1.1rem; color: var(--rz-primary);" />
                                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">@_a.TotalCumule.ToString("0.##") €</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">cumulés</RadzenText>
                                    </RadzenStack>

                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>
                    }
                </RadzenRow>
            </RadzenStack>
        }
    </RadzenCard>
}

@* Comptes utilisateurs : consultation et suppression definitive *@
@if (!_chargement)
{
    <RadzenCard Variant="Variant.Outlined" Style="margin-top: 1.5rem;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1rem;">
            <RadzenIcon Icon="manage_accounts" Style="font-size: 1.5rem; color: var(--rz-primary);" />
            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Comptes utilisateurs</RadzenText>
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@_comptes.Count.ToString()" IsPill="true" />
        </RadzenStack>

        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                La suppression est definitive. Un compte ancre dans un historique d'achat ou
                une commission validee n'est pas supprimable : bloquez-le, l'acces est coupe
                sans rien detruire.
            </RadzenText>

            <RadzenFormField Text="Rechercher (nom, email, role)" Variant="Variant.Outlined" Style="width: 100%;">
                <Start><RadzenIcon Icon="search" /></Start>
                <ChildContent>
                    <RadzenTextBox Value="@_recherche" @oninput="MajRecherche" Style="width: 100%;" />
                </ChildContent>
            </RadzenFormField>

            @if (ComptesFiltres().Count == 0)
            {
                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                    Aucun compte ne correspond.
                </RadzenText>
            }
            else
            {
                <RadzenRow Gap="1rem">
                    @foreach (var _c in ComptesFiltres())
                    {
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                                <RadzenStack Gap="0.5rem">

                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">@_c.Prenom @_c.Nom</RadzenText>
                                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@LibelleRole(_c.Role)" IsPill="true" />
                                    </RadzenStack>

                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); overflow-wrap: anywhere;">@_c.Email</RadzenText>

                                    @if (!string.IsNullOrEmpty(_c.NomSociete))
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                            <RadzenIcon Icon="business" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">@_c.NomSociete</RadzenText>
                                        </RadzenStack>
                                    }

                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.4rem" Wrap="FlexWrap.Wrap">
                                        @if (!_c.EstActif)
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Bloque" IsPill="true" />
                                        }
                                        @if (_c.EstSousCompte)
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Sous-compte" IsPill="true" />
                                        }
                                    </RadzenStack>

                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                        Cree le @_c.DateCreation.ToLocalTime().ToString("dd/MM/yyyy")
                                    </RadzenText>

                                    @if (_c.Role == "Admin")
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                            Compte administrateur : non supprimable ici.
                                        </RadzenText>
                                    }
                                    else
                                    {
                                        <RadzenButton Text="Supprimer" Icon="delete_forever" ButtonStyle="ButtonStyle.Danger"
                                                      Variant="Variant.Outlined" Size="ButtonSize.Small" Style="width: 100%;"
                                                      Click="() => SupprimerCompte(_c)" />
                                    }

                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>
                    }
                </RadzenRow>
            }
        </RadzenStack>
    </RadzenCard>
}

@code {
    private List<DTO_EntrepriseAdmin> _entreprises = new();
    private List<DTO_FournisseurAdmin> _fournisseurs = new();
    private List<DTO_ApporteurAdmin> _apporteurs = new();
    private List<DTO_CompteAdmin> _comptes = new();
    private string _recherche = string.Empty;
    private bool _chargement = true;

