    // Bloque / débloque un fournisseur ; sur un compte principal, ses sous-comptes suivent
    private async Task BasculerBlocage(DTO_FournisseurAdmin p_f)
    {
        var _nomAffiche = $"{p_f.Prenom} {p_f.Nom}".Trim();

        string _action;
        if (p_f.EstActif)
        {
            _action = "Bloquer";
        }
        else
        {
            _action = "Débloquer";
        }

        // Le message annonce la cascade quand le compte principal a des sous-comptes
        string _question;
        if (p_f.EstActif)
        {
            _question = $"Bloquer le compte fournisseur « {_nomAffiche} » ? Il ne pourra plus se connecter.";
            if (!p_f.EstSousCompte && p_f.NombreSousComptes > 0)
            {
                _question = $"Bloquer le compte fournisseur « {_nomAffiche} » ainsi que ses {p_f.NombreSousComptes} sous-compte(s) ? Aucun d'eux ne pourra plus se connecter.";
            }
        }
        else
        {
            _question = $"Débloquer le compte fournisseur « {_nomAffiche} » ? Il pourra de nouveau se connecter.";
            if (!p_f.EstSousCompte && p_f.NombreSousComptes > 0)
            {
                _question = $"Débloquer le compte fournisseur « {_nomAffiche} » ainsi que ses {p_f.NombreSousComptes} sous-compte(s) ?";
            }
        }

        var _confirm = await Dialog.Confirm(
            _question,
            "Confirmation",
            new ConfirmOptions { OkButtonText = _action, CancelButtonText = "Annuler" });

        if (_confirm == true)
        {
            var (_succes, _message) = await SAdmin.BasculerBlocageFournisseur(p_f.Id);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Success, "Succès", _message);
                _fournisseurs = await SAdmin.ObtenirFournisseurs();
                StateHasChanged();
            }
            else
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private async Task Basculer(DTO_EntrepriseAdmin p_entreprise)
    {
        try
        {
            // Autoriser une entreprise parrainée dont la commission n'est pas encore fixée
            // passe par un dialogue dédié : c'est le seul moment où le montant se décide.
            if (!p_entreprise.EstAutorisee && p_entreprise.EstParrainee && !p_entreprise.ParrainageDejaValide)
            {
                await AutoriserAvecCommission(p_entreprise);
                return;
            }

            var _estAutorisee = p_entreprise.EstAutorisee;
            string _texteAction;
            if (_estAutorisee)
            {
                _texteAction = "Bloquer";
            }
            else
            {
                _texteAction = "Autoriser";
            }
            var _confirm = await Dialog.Confirm(
                $"Voulez-vous {_texteAction.ToLower()} l'entreprise « {p_entreprise.Nom} » ?",
                "Confirmation",
                new ConfirmOptions { OkButtonText = _texteAction, CancelButtonText = "Annuler" });

            if (_confirm == true)
            {
                var (_succes, _message) = await SAdmin.BasculerAutorisation(p_entreprise.Id, 0m);
                if (_succes)
                {
                    Notification.Notify(NotificationSeverity.Success, "Succès", _message);
                    await Recharger();
                }
                else
                    Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
            }
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
    }

    // Montant proposé par défaut dans le dialogue. L'admin reste libre de le changer :
    // c'est lui qui décide, ce chiffre n'est qu'un point de départ.
    private const decimal c_commissionProposee = 20m;

    private async Task AutoriserAvecCommission(DTO_EntrepriseAdmin p_entreprise)
    {
        var _nomApporteur = string.Empty;
        if (p_entreprise.NomApporteur != null)
        {
            _nomApporteur = p_entreprise.NomApporteur;
        }
        var _code = string.Empty;
        if (p_entreprise.CodeParrainageUtilise != null)
        {
            _code = p_entreprise.CodeParrainageUtilise;
        }

        var _result = await Dialog.OpenAsync<Comp_DialogAutoriserParrainage>("Autoriser et fixer la commission",
            new Dictionary<string, object?>
            {
                { "NomEntreprise", p_entreprise.Nom },
                { "NomApporteur", _nomApporteur },
                { "CodeParrainage", _code },
                { "MontantPropose", c_commissionProposee }
            },
            new DialogOptions { Width = "480px", CloseDialogOnOverlayClick = false });

        if (_result is decimal _montant)
        {
            var (_succes, _message) = await SAdmin.BasculerAutorisation(p_entreprise.Id, _montant);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Success, "Succès", _message);
                await Recharger();
            }
            else
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private async Task Recharger()
    {
        _entreprises = await SAdmin.ObtenirEntreprises();
        _apporteurs = await SApporteur.ObtenirApporteursAdmin();
        _comptes = await SAdmin.ObtenirComptes();
        StateHasChanged();
    }

    private void MajRecherche(ChangeEventArgs p_e)
    {
        if (p_e.Value == null)
        {
            _recherche = string.Empty;
            return;
        }
        var _valeur = p_e.Value.ToString();
        if (_valeur == null)
        {
            _recherche = string.Empty;
            return;
        }
        _recherche = _valeur;
    }

    private static string LibelleRole(string p_role)
    {
        if (p_role == "ApporteurAffaire")
        {
            return "Apporteur d'affaires";
        }
        return p_role;
    }

    private List<DTO_CompteAdmin> ComptesFiltres()
    {
        var _terme = _recherche.Trim().ToLower();
        if (_terme.Length == 0)
        {
            return _comptes;
        }

        var _result = new List<DTO_CompteAdmin>();
        foreach (var _c in _comptes)
        {
            var _cible = (_c.Prenom + " " + _c.Nom + " " + _c.Email + " " + LibelleRole(_c.Role)).ToLower();
            if (_c.NomSociete != null)
            {
                _cible = _cible + " " + _c.NomSociete.ToLower();
            }
            if (_cible.Contains(_terme))
            {
                _result.Add(_c);
            }
        }
        return _result;
    }

    // Suppression definitive : le dialogue porte les DEUX confirmations
    // (etendue des degats, puis email a recopier).
    private async Task SupprimerCompte(DTO_CompteAdmin p_compte)
    {
        var _resultat = await Dialog.OpenAsync<Comp_DialogSupprimerCompte>("Supprimer un compte",
            new Dictionary<string, object?>
            {
                { "UtilisateurId", p_compte.Id }
            },
            new DialogOptions { Width = "520px", CloseDialogOnOverlayClick = false });

        if (_resultat is ValueTuple<bool, string> _retour)
        {
            if (_retour.Item1)
            {
                Notification.Notify(NotificationSeverity.Success, "Compte supprime", _retour.Item2);
                await Recharger();
            }
            else
            {
                Notification.Notify(NotificationSeverity.Error, "Suppression refusee", _retour.Item2);
            }
        }
    }
