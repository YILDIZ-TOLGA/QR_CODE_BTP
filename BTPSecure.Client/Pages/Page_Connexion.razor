@page "/connexion"
@page "/"
@inject S_Auth SAuth
@inject NavigationManager Navigation
@inject NotificationService Notification

<RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="min-height: 85vh;">
    <RadzenColumn Size="12" SizeSM="10" SizeMD="6" SizeLG="4" SizeXL="3">
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Gap="1.5rem" AlignItems="AlignItems.Center">

                <RadzenIcon Icon="shield" Style="font-size: 3rem; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" TextAlign="TextAlign.Center">
                    Connexion
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle1" TextAlign="TextAlign.Center" Style="color: var(--rz-text-secondary-color); margin-top: -1rem;">
                    Accédez à votre espace BTPSecure
                </RadzenText>

                <RadzenTemplateForm TItem="DTO_Connexion" Data="_dto" Submit="Connecter" Style="width: 100%;">
                    <RadzenStack Gap="1.25rem">
                        <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start>
                                <RadzenIcon Icon="mail" />
                            </Start>
                            <ChildContent>
                                <RadzenTextBox @bind-Value="_dto.Email" Name="Email" Style="width: 100%;" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="Email" Text="L'email est obligatoire." />
                            </Helper>
                        </RadzenFormField>

                        <RadzenFormField Text="Mot de passe" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start>
                                <RadzenIcon Icon="lock" />
                            </Start>
                            <ChildContent>
                                <RadzenPassword @bind-Value="_dto.MotDePasse" Name="MotDePasse" Style="width: 100%;" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="MotDePasse" Text="Le mot de passe est obligatoire." />
                            </Helper>
                        </RadzenFormField>

                        <RadzenButton Text="Se connecter" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Large" Style="width: 100%;" IsBusy="_enChargement" Icon="login" />
                    </RadzenStack>
                </RadzenTemplateForm>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                        Pas encore de compte ?
                    </RadzenText>
                    <RadzenLink Path="/inscription" Text="S'inscrire" Style="font-weight: 600;" />
                </RadzenStack>

            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@code {
    private DTO_Connexion _dto = new();
    private bool _enChargement;

    private async Task Connecter()
    {
        _enChargement = true;
        var (_succes, _message, _reponse) = await SAuth.Connecter(_dto);
        _enChargement = false;

        if (!_succes)
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
            return;
        }

        var _url = _reponse!.Role switch
        {
            Enum_Role.Patron => "/patron",
            Enum_Role.Salarie => "/salarie",
            Enum_Role.Fournisseur => "/fournisseur",
            _ => "/"
        };
        Navigation.NavigateTo(_url);
    }
}
