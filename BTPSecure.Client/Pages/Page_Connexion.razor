@page "/connexion"
@page "/"
@inject S_Auth SAuth
@inject S_AuthStateProvider AuthState
@inject NavigationManager Navigation
@inject NotificationService Notification

<RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="min-height: 85vh;">
    <RadzenColumn Size="12" SizeSM="10" SizeMD="6" SizeLG="4" SizeXL="3">
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Gap="1.5rem" AlignItems="AlignItems.Center">

                <div style="color: var(--rz-primary);"><Comp_Logo Complet="true" Hauteur="2.2rem" /></div>
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" TextAlign="TextAlign.Center" Style="margin-top: -0.5rem;">
                    Connexion
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle1" TextAlign="TextAlign.Center" Style="color: var(--rz-text-secondary-color); margin-top: -1rem;">
                    Accédez à votre espace KEYDO
                </RadzenText>

                <RadzenTemplateForm TItem="DTO_Connexion" Data="_dto" Submit="Connecter" Style="width: 100%;">
                    <RadzenStack Gap="1.25rem">
                        <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start>
                                <RadzenIcon Icon="mail" />
                            </Start>
                            <ChildContent>
                                <RadzenTextBox @bind-Value="_dto.Email" Name="Email" Style="width: 100%;" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="Email" Text="L'email est obligatoire." />
                            </Helper>
                        </RadzenFormField>

                        <RadzenFormField Text="Mot de passe" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start>
                                <RadzenIcon Icon="lock" />
                            </Start>
                            <ChildContent>
                                @if (_voirMotDePasse)
                                {
                                    <RadzenTextBox @bind-Value="_dto.MotDePasse" Name="MotDePasse" Style="width: 100%;" />
                                }
                                else
                                {
                                    <RadzenPassword @bind-Value="_dto.MotDePasse" Name="MotDePasse" Style="width: 100%;" />
                                }
                            </ChildContent>
                            <End>
                                <RadzenButton Icon="@(_voirMotDePasse ? "visibility_off" : "visibility")"
                                              Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                              Click="@(() => _voirMotDePasse = !_voirMotDePasse)" type="button" />
                            </End>
                            <Helper>
                                <RadzenRequiredValidator Component="MotDePasse" Text="Le mot de passe est obligatoire." />
                            </Helper>
                        </RadzenFormField>

                        <RadzenButton Text="Se connecter" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Large" Style="width: 100%;" IsBusy="_enChargement" Icon="login" />

                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center">
                            <RadzenLink Path="/mot-de-passe-oublie" Text="Mot de passe oublié ?" Style="font-size: 0.9rem;" />
                        </RadzenStack>

                        @if (_emailNonVerifie)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" Style="margin-top: 0.5rem;">
                                Votre email n'est pas vérifié. Vérifiez votre boîte mail (+ spam) ou cliquez ci-dessous pour recevoir un nouveau lien.
                            </RadzenAlert>
                            <RadzenButton Text="Renvoyer l'email de vérification" Icon="forward_to_inbox"
                                          ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                                          Style="width: 100%;" IsBusy="_envoiEnCours" Click="RenvoyerVerification" />
                        }
                    </RadzenStack>
                </RadzenTemplateForm>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                        Pas encore de compte ?
                    </RadzenText>
                    <RadzenLink Path="/inscription" Text="S'inscrire" Style="font-weight: 600;" />
                </RadzenStack>

            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@code {
    private DTO_Connexion _dto = new();
    private bool _enChargement;
    private bool _emailNonVerifie;
    private bool _envoiEnCours;
    private bool _voirMotDePasse;

    protected override async Task OnInitializedAsync()
    {
        var _etat = await AuthState.GetAuthenticationStateAsync();

        if (_etat.User.Identity == null)
        {
            return;
        }
        if (!_etat.User.Identity.IsAuthenticated)
        {
            return;
        }

        var _claimRole = _etat.User.FindFirst("role");
        if (_claimRole == null)
        {
            _claimRole = _etat.User.FindFirst(System.Security.Claims.ClaimTypes.Role);
        }
        if (_claimRole == null)
        {
            return;
        }

        string _url = "/";
        if (_claimRole.Value == "Admin")
        {
            _url = "/admin";
        }
        else if (_claimRole.Value == "Dirigeant")
        {
            _url = "/dirigeant";
        }
        else if (_claimRole.Value == "Collaborateur")
        {
            _url = "/collaborateur";
        }
        else if (_claimRole.Value == "Fournisseur")
        {
            _url = "/fournisseur";
        }

        if (_url != "/")
        {
            Navigation.NavigateTo(_url, false, true);
        }
    }

    private async Task Connecter()
    {
        _enChargement = true;
        _emailNonVerifie = false;
        var (_succes, _message, _reponse) = await SAuth.Connecter(_dto);
        _enChargement = false;

        if (!_succes)
        {
            if (_message.Contains("vérifié", StringComparison.OrdinalIgnoreCase))
            {
                _emailNonVerifie = true;
            }
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
            return;
        }

        if (_reponse == null)
        {
            return;
        }

        string _url = "/";
        if (_reponse.Role == Enum_Role.Admin)
        {
            _url = "/admin";
        }
        else if (_reponse.Role == Enum_Role.Dirigeant)
        {
            _url = "/dirigeant";
        }
        else if (_reponse.Role == Enum_Role.Collaborateur)
        {
            _url = "/collaborateur";
        }
        else if (_reponse.Role == Enum_Role.Fournisseur)
        {
            _url = "/fournisseur";
        }

        Navigation.NavigateTo(_url);
    }

    private async Task RenvoyerVerification()
    {
        if (string.IsNullOrWhiteSpace(_dto.Email))
        {
            Notification.Notify(NotificationSeverity.Warning, "Email manquant", "Saisissez votre email d'abord.");
            return;
        }
        _envoiEnCours = true;
        var (_ok, _msg) = await SAuth.RenvoyerVerification(_dto.Email);
        _envoiEnCours = false;
        Notification.Notify(NotificationSeverity.Info, "Demande envoyée", _msg);
    }
}
