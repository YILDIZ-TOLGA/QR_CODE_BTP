@page "/patron"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Patron")]
@inject Services.S_Entreprise SEntreprise
@inject Services.S_Code SCode
@inject NavigationManager Navigation
@inject NotificationService Notification
@inject DialogService Dialog

<RadzenText TextStyle="TextStyle.H4">Tableau de bord Patron</RadzenText>

@if (_entreprise == null)
{
    <RadzenCard Style="margin-top:1rem;">
        <RadzenText TextStyle="TextStyle.H5">Créer votre entreprise</RadzenText>
        <RadzenTemplateForm TItem="DTO_CreerEntreprise" Data="_dtoEntreprise" Submit="CreerEntreprise">
            <RadzenStack Gap="1rem" Style="margin-top:1rem;">
                <RadzenFormField Text="Nom de l'entreprise" Style="width:100%;">
                    <RadzenTextBox @bind-Value="_dtoEntreprise.Nom" Name="NomEntreprise" Style="width:100%;" />
                    <RadzenRequiredValidator Component="NomEntreprise" Text="Le nom est obligatoire." />
                </RadzenFormField>
                <RadzenFormField Text="Adresse (optionnel)" Style="width:100%;">
                    <RadzenTextBox @bind-Value="_dtoEntreprise.Adresse" Style="width:100%;" />
                </RadzenFormField>
                <RadzenFormField Text="SIRET (optionnel)" Style="width:100%;">
                    <RadzenTextBox @bind-Value="_dtoEntreprise.Siret" Style="width:100%;" />
                </RadzenFormField>
                <RadzenButton Text="Créer l'entreprise" ButtonType="ButtonType.Submit" Icon="business" ButtonStyle="ButtonStyle.Primary" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
}
else
{
    <RadzenCard Style="margin-top:1rem;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenStack>
                <RadzenText TextStyle="TextStyle.H5">@_entreprise.Nom</RadzenText>
                @if (!string.IsNullOrEmpty(_entreprise.Adresse)) { <RadzenText TextStyle="TextStyle.Body2">@_entreprise.Adresse</RadzenText> }
                @if (!string.IsNullOrEmpty(_entreprise.Siret)) { <RadzenText TextStyle="TextStyle.Body2">SIRET : @_entreprise.Siret</RadzenText> }
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    <!-- Salariés -->
    <RadzenCard Style="margin-top:1rem;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:0.5rem;">
            <RadzenText TextStyle="TextStyle.H5">Salariés</RadzenText>
            <RadzenButton Text="Ajouter un salarié" Icon="person_add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="OuvrirAjoutSalarie" />
        </RadzenStack>
        <RadzenDataGrid Data="_salaries" TItem="DTO_SalarieAffichage" AllowPaging="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="DTO_SalarieAffichage" Property="Nom" Title="Nom" />
                <RadzenDataGridColumn TItem="DTO_SalarieAffichage" Property="Prenom" Title="Prénom" />
                <RadzenDataGridColumn TItem="DTO_SalarieAffichage" Property="Email" Title="Email" />
                <RadzenDataGridColumn TItem="DTO_SalarieAffichage" Title="Actions" Width="120px" TextAlign="TextAlign.Center">
                    <Template Context="s">
                        <RadzenButton Icon="person_remove" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                      Click="() => RetirerSalarie(s)" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>

    <!-- Codes -->
    <RadzenCard Style="margin-top:1rem;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:0.5rem;">
            <RadzenText TextStyle="TextStyle.H5">Codes d'autorisation</RadzenText>
            <RadzenButton Text="Créer un code" Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                          Click='() => Navigation.NavigateTo("/patron/creer-code")' />
        </RadzenStack>
        <RadzenDataGrid Data="_codes" TItem="DTO_CodeAffichage" AllowPaging="true" PageSize="10" AllowSorting="true">
            <Columns>
                <RadzenDataGridColumn TItem="DTO_CodeAffichage" Property="Valeur" Title="Code" Width="130px">
                    <Template Context="c">
                        <RadzenText Style="font-family:monospace; font-weight:bold;">@c.Valeur</RadzenText>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DTO_CodeAffichage" Title="Salarié">
                    <Template Context="c">@c.PrenomSalarie @c.NomSalarie</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DTO_CodeAffichage" Title="Type" Width="100px">
                    <Template Context="c">
                        <RadzenBadge BadgeStyle="@(c.TypeCode == Enum_TypeCode.Confiance ? BadgeStyle.Info : BadgeStyle.Warning)"
                                     Text="@c.TypeCode.ToString()" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DTO_CodeAffichage" Title="Statut" Width="100px">
                    <Template Context="c">
                        <RadzenBadge BadgeStyle="@ObtenirStyleStatut(c.Statut)" Text="@c.Statut.ToString()" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DTO_CodeAffichage" Property="NumeroCommande" Title="N° Commande" />
                <RadzenDataGridColumn TItem="DTO_CodeAffichage" Title="Expiration" Width="160px">
                    <Template Context="c">
                        @(c.DateExpiration?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="DTO_CodeAffichage" Title="Actions" Width="100px" TextAlign="TextAlign.Center">
                    <Template Context="c">
                        @if (c.Statut == Enum_StatutCode.Actif)
                        {
                            <RadzenButton Icon="block" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                          Click="() => RevoquerCode(c)" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@code {
    private DTO_EntrepriseAffichage? _entreprise;
    private DTO_CreerEntreprise _dtoEntreprise = new();
    private List<DTO_SalarieAffichage> _salaries = new();
    private List<DTO_CodeAffichage> _codes = new();

    protected override async Task OnInitializedAsync()
    {
        await ChargerDonnees();
    }

    private async Task ChargerDonnees()
    {
        _entreprise = await SEntreprise.ObtenirMonEntreprise();
        if (_entreprise != null)
        {
            _salaries = await SEntreprise.ObtenirSalaries();
            _codes = await SCode.ObtenirParPatron();
        }
    }

    private async Task CreerEntreprise()
    {
        var (_succes, _message, _ent) = await SEntreprise.Creer(_dtoEntreprise);
        if (_succes)
        {
            Notification.Notify(NotificationSeverity.Success, "Succès", _message);
            await ChargerDonnees();
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private async Task OuvrirAjoutSalarie()
    {
        var _email = await Dialog.OpenAsync<Comp_DialogAjoutSalarie>("Ajouter un salarié");
        if (_email is string email && !string.IsNullOrWhiteSpace(email))
        {
            var (_succes, _message, _) = await SEntreprise.AjouterSalarie(email);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Success, "Succès", _message);
                _salaries = await SEntreprise.ObtenirSalaries();
            }
            else
            {
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
            }
        }
    }

    private async Task RetirerSalarie(DTO_SalarieAffichage p_salarie)
    {
        var _confirm = await Dialog.Confirm($"Retirer {p_salarie.Prenom} {p_salarie.Nom} ? Ses codes liés seront révoqués.", "Confirmation");
        if (_confirm == true)
        {
            var (_succes, _message) = await SEntreprise.RetirerSalarie(p_salarie.Id);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Success, "Succès", _message);
                await ChargerDonnees();
            }
            else
            {
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
            }
        }
    }

    private async Task RevoquerCode(DTO_CodeAffichage p_code)
    {
        var _confirm = await Dialog.Confirm($"Révoquer le code {p_code.Valeur} ?", "Confirmation");
        if (_confirm == true)
        {
            var (_succes, _message) = await SCode.Revoquer(p_code.Id);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Success, "Succès", _message);
                _codes = await SCode.ObtenirParPatron();
            }
            else
            {
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
            }
        }
    }

    private static BadgeStyle ObtenirStyleStatut(Enum_StatutCode p_statut) => p_statut switch
    {
        Enum_StatutCode.Actif => BadgeStyle.Success,
        Enum_StatutCode.Utilise => BadgeStyle.Info,
        Enum_StatutCode.Expire => BadgeStyle.Light,
        Enum_StatutCode.Revoque => BadgeStyle.Danger,
        _ => BadgeStyle.Light
    };
}
