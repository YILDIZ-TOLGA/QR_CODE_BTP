@page "/patron"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Patron")]
@inject Services.S_Entreprise SEntreprise
@inject Services.S_Code SCode
@inject NavigationManager Navigation
@inject NotificationService Notification
@inject DialogService Dialog

@if (_entreprise == null && !_chargement)
{
    <RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="min-height: 70vh;">
        <RadzenColumn Size="12" SizeMD="8" SizeLG="5">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="1.5rem" AlignItems="AlignItems.Center">
                    <RadzenIcon Icon="domain_add" Style="font-size: 3rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" TextAlign="TextAlign.Center">Créer votre entreprise</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle1" TextAlign="TextAlign.Center" Style="color: var(--rz-text-secondary-color); margin-top: -1rem;">
                        Commencez par enregistrer votre société
                    </RadzenText>

                    <RadzenTemplateForm TItem="DTO_CreerEntreprise" Data="_dtoEntreprise" Submit="CreerEntreprise" Style="width: 100%;">
                        <RadzenStack Gap="1.25rem">
                            <RadzenFormField Text="Nom de l'entreprise" Variant="Variant.Outlined" Style="width: 100%;">
                                <Start><RadzenIcon Icon="business" /></Start>
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="_dtoEntreprise.Nom" Name="NomEntreprise" Style="width: 100%;" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="NomEntreprise" Text="Le nom est obligatoire." />
                                </Helper>
                            </RadzenFormField>

                            <RadzenFormField Text="Adresse" Variant="Variant.Outlined" Style="width: 100%;">
                                <Start><RadzenIcon Icon="location_on" /></Start>
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="_dtoEntreprise.Adresse" Style="width: 100%;" Placeholder="Optionnel" />
                                </ChildContent>
                            </RadzenFormField>

                            <RadzenFormField Text="SIRET" Variant="Variant.Outlined" Style="width: 100%;">
                                <Start><RadzenIcon Icon="pin" /></Start>
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="_dtoEntreprise.Siret" Style="width: 100%;" Placeholder="Optionnel" />
                                </ChildContent>
                            </RadzenFormField>

                            <RadzenButton Text="Créer l'entreprise" ButtonType="ButtonType.Submit" Icon="rocket_launch"
                                          ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenTemplateForm>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
}
else if (_chargement)
{
    <RadzenRow JustifyContent="JustifyContent.Center" Style="margin-top: 4rem;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
    </RadzenRow>
}
else
{
    <RadzenStack Gap="1.5rem">
        @if (_nbNotifications > 0)
        {
            <RadzenCard Variant="Variant.Filled" Style="background: var(--rz-success); color: white; cursor: pointer;"
                        @onclick='() => Navigation.NavigateTo("/patron/notifications")'>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                        <RadzenIcon Icon="notifications_active" Style="font-size: 2rem; color: white;" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: white;">
                                Vous avez @_nbNotifications commande(s) prête(s)
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: rgba(255,255,255,0.85);">
                                Cliquez pour voir le détail
                            </RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                    <RadzenIcon Icon="arrow_forward" Style="color: white;" />
                </RadzenStack>
            </RadzenCard>
        }

        @if (!_entreprise!.EstAutorisee)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat"
                         Title="Entreprise en attente d'autorisation">
                Votre entreprise n'est pas encore autorisée par l'administrateur. Vous ne pouvez pas créer de codes pour le moment.
            </RadzenAlert>
        }

        <!-- En-tête entreprise -->
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenIcon Icon="business" Style="font-size: 2.5rem; color: var(--rz-primary);" />
                    <RadzenStack Gap="0">
                        <RadzenText TextStyle="TextStyle.H5" Style="margin: 0;">@_entreprise!.Nom</RadzenText>
                        @if (!string.IsNullOrEmpty(_entreprise.Siret))
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">SIRET : @_entreprise.Siret</RadzenText>
                        }
                        @if (!string.IsNullOrEmpty(_entreprise.Adresse))
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">@_entreprise.Adresse</RadzenText>
                        }
                    </RadzenStack>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    @if (_entreprise!.EstAutorisee)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Autorisée" IsPill="true" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="En attente" IsPill="true" />
                    }
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{_salaries.Count} salarié(s)")" IsPill="true" />
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@($"{_codes.Count(c => c.Statut == Enum_StatutCode.Actif)} code(s) actif(s)")" IsPill="true" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <!-- Salariés -->
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom: 1rem;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="groups" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Salariés</RadzenText>
                </RadzenStack>
                <RadzenButton Text="Ajouter" Icon="person_add" ButtonStyle="ButtonStyle.Success"
                              Variant="Variant.Flat" Size="ButtonSize.Small" Click="OuvrirAjoutSalarie" />
            </RadzenStack>

            @if (_salaries.Count == 0)
            {
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 2rem 0;">
                    <RadzenIcon Icon="group_off" Style="font-size: 2.5rem; color: var(--rz-text-disabled-color);" />
                    <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">Aucun salarié pour le moment</RadzenText>
                </RadzenStack>
            }
            else
            {
                <RadzenRow Gap="1rem">
                    @foreach (var _sal in _salaries)
                    {
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                                <RadzenStack Gap="0.75rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="min-width: 0; flex: 1;">
                                            <RadzenIcon Icon="account_circle" Style="font-size: 1.8rem; color: var(--rz-primary);" />
                                            <RadzenText Style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@_sal.Prenom @_sal.Nom</RadzenText>
                                        </RadzenStack>
                                        @if (_sal.StatutInvitation == BTPSecure.Shared.Enums.Enum_StatutInvitation.Acceptee)
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Accepté" IsPill="true" />
                                        }
                                        else
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="En attente" IsPill="true" />
                                        }
                                    </RadzenStack>

                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="mail" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                        <RadzenText TextStyle="TextStyle.Body2" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@_sal.Email</RadzenText>
                                    </RadzenStack>

                                    <RadzenButton Text="Retirer" Icon="person_remove" ButtonStyle="ButtonStyle.Danger"
                                                  Variant="Variant.Outlined" Size="ButtonSize.Small" Style="width: 100%;"
                                                  Click="() => RetirerSalarie(_sal)" />
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>
                    }
                </RadzenRow>
            }
        </RadzenCard>

        <!-- Codes -->
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom: 1rem;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="qr_code_2" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Codes d'autorisation</RadzenText>
                </RadzenStack>
                @if (_entreprise!.EstAutorisee)
                {
                    <RadzenButton Text="Créer un code" Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                                  Variant="Variant.Flat" Size="ButtonSize.Small"
                                  Click='() => Navigation.NavigateTo("/patron/creer-code")' />
                }
            </RadzenStack>

            @if (_codes.Count == 0)
            {
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 2rem 0;">
                    <RadzenIcon Icon="code_off" Style="font-size: 2.5rem; color: var(--rz-text-disabled-color);" />
                    <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">Aucun code créé</RadzenText>
                </RadzenStack>
            }
            else
            {
                <RadzenRow Gap="1rem">
                    @foreach (var _c in _codes)
                    {
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                                <RadzenStack Gap="0.75rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                        @if (_c.TypeCode == Enum_TypeCode.Confiance)
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@_c.TypeCode.ToString()" IsPill="true" />
                                        }
                                        else
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@_c.TypeCode.ToString()" IsPill="true" />
                                        }
                                        <RadzenBadge BadgeStyle="@ObtenirStyleStatut(_c.Statut)" Text="@_c.Statut.ToString()" IsPill="true" />
                                    </RadzenStack>

                                    <RadzenCard Variant="Variant.Filled" Style="background: var(--rz-primary); padding: 0.75rem;">
                                        <RadzenText TextStyle="TextStyle.H4" TextAlign="TextAlign.Center"
                                                    Style="font-family: monospace; letter-spacing: 3px; color: white; margin: 0;">
                                            @_c.Valeur
                                        </RadzenText>
                                    </RadzenCard>

                                    <RadzenStack Gap="0.4rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="person" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Body2">@_c.PrenomSalarie @_c.NomSalarie</RadzenText>
                                        </RadzenStack>
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="receipt_long" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Body2">@_c.NumeroCommande</RadzenText>
                                        </RadzenStack>
                                        @if (_c.DateExpiration.HasValue)
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                <RadzenIcon Icon="schedule" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                    Expire le @_c.DateExpiration.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                </RadzenText>
                                            </RadzenStack>
                                        }
                                    </RadzenStack>

                                    @if (_c.Statut == Enum_StatutCode.Actif)
                                    {
                                        <RadzenButton Text="Révoquer" Icon="block" ButtonStyle="ButtonStyle.Danger"
                                                      Variant="Variant.Outlined" Size="ButtonSize.Small" Style="width: 100%;"
                                                      Click="() => RevoquerCode(_c)" />
                                    }
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>
                    }
                </RadzenRow>
            }
        </RadzenCard>
    </RadzenStack>
}

@code {
    private DTO_EntrepriseAffichage? _entreprise;
    private DTO_CreerEntreprise _dtoEntreprise = new();
    private List<DTO_SalarieAffichage> _salaries = new();
    private List<DTO_CodeAffichage> _codes = new();
    private int _nbNotifications = 0;
    private bool _chargement = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ChargerDonnees();
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChargerDonnees()
    {
        _entreprise = await SEntreprise.ObtenirMonEntreprise();
        if (_entreprise != null)
        {
            _salaries = await SEntreprise.ObtenirSalaries();
            _codes = await SCode.ObtenirParPatron();
            var _notifs = await SCode.ObtenirNotificationsPatron();
            _nbNotifications = _notifs.Count;
        }
    }

    private async Task CreerEntreprise()
    {
        var (_succes, _message, _) = await SEntreprise.Creer(_dtoEntreprise);
        if (_succes)
        {
            Notification.Notify(NotificationSeverity.Success, "Succès", _message);
            await ChargerDonnees();
        }
        else
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
    }

    private async Task OuvrirAjoutSalarie()
    {
        var _email = await Dialog.OpenAsync<Comp_DialogAjoutSalarie>("Ajouter un salarié",
            options: new DialogOptions { Width = "480px", CloseDialogOnOverlayClick = true });
        if (_email is string email && !string.IsNullOrWhiteSpace(email))
        {
            var (_succes, _message, _) = await SEntreprise.AjouterSalarie(email);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Success, "Succès", _message);
                _salaries = await SEntreprise.ObtenirSalaries();
            }
            else
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private async Task RetirerSalarie(DTO_SalarieAffichage p_salarie)
    {
        var _confirm = await Dialog.Confirm(
            $"Retirer {p_salarie.Prenom} {p_salarie.Nom} de l'entreprise ? Ses codes actifs seront révoqués.",
            "Confirmer le retrait",
            new ConfirmOptions { OkButtonText = "Retirer", CancelButtonText = "Annuler" });
        if (_confirm == true)
        {
            var (_succes, _message) = await SEntreprise.RetirerSalarie(p_salarie.Id);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Success, "Succès", _message);
                await ChargerDonnees();
            }
            else
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private async Task RevoquerCode(DTO_CodeAffichage p_code)
    {
        var _confirm = await Dialog.Confirm(
            $"Révoquer le code {p_code.Valeur} ? Cette action est irréversible.",
            "Confirmer la révocation",
            new ConfirmOptions { OkButtonText = "Révoquer", CancelButtonText = "Annuler" });
        if (_confirm == true)
        {
            var (_succes, _message) = await SCode.Revoquer(p_code.Id);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Success, "Succès", _message);
                _codes = await SCode.ObtenirParPatron();
            }
            else
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private static BadgeStyle ObtenirStyleStatut(Enum_StatutCode p_statut)
    {
        if (p_statut == Enum_StatutCode.Actif)
        {
            return BadgeStyle.Success;
        }
        if (p_statut == Enum_StatutCode.Utilise)
        {
            return BadgeStyle.Info;
        }
        if (p_statut == Enum_StatutCode.Expire)
        {
            return BadgeStyle.Light;
        }
        if (p_statut == Enum_StatutCode.Revoque)
        {
            return BadgeStyle.Danger;
        }
        return BadgeStyle.Light;
    }
}
