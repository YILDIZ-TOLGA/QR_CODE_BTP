@page "/patron/creer-salarie"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Patron")]
@inject Services.S_Entreprise SEntreprise
@inject NavigationManager Navigation
@inject NotificationService Notification

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1.5rem;">
    <RadzenButton Icon="arrow_back" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Large"
                  Click='() => Navigation.NavigateTo("/patron")' />
    <RadzenIcon Icon="person_add" Style="font-size: 2rem; color: var(--rz-primary);" />
    <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Création d'un collaborateur</RadzenText>
</RadzenStack>

<RadzenRow JustifyContent="JustifyContent.Center">
    <RadzenColumn Size="12" SizeMD="8" SizeLG="6">
        @if (_succes)
        {
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="1.5rem" AlignItems="AlignItems.Center">
                    <RadzenIcon Icon="check_circle" Style="font-size: 4rem; color: var(--rz-success);" />
                    <RadzenText TextStyle="TextStyle.H5" TextAlign="TextAlign.Center" Style="color: var(--rz-success);">
                        Collaborateur créé avec succès
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" TextAlign="TextAlign.Center">
                        Un email contenant ses identifiants (email + mot de passe temporaire) a été envoyé à <strong>@_emailEnvoye</strong>.
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" TextAlign="TextAlign.Center" Style="color: var(--rz-text-secondary-color);">
                        Il est automatiquement rattaché à votre entreprise.
                    </RadzenText>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Style="width: 100%;">
                        <RadzenButton Text="Créer un autre collaborateur" Icon="person_add" ButtonStyle="ButtonStyle.Primary"
                                      Variant="Variant.Outlined" Style="flex: 1;" Click="Reinitialiser" />
                        <RadzenButton Text="Tableau de bord" Icon="dashboard" ButtonStyle="ButtonStyle.Primary"
                                      Style="flex: 1;" Click='() => Navigation.NavigateTo("/patron")' />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        }
        else
        {
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="1rem" Style="margin-bottom: 1.5rem;">
                    <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                        Renseignez les informations de votre collaborateur. Un compte lui sera créé et un email contenant ses identifiants temporaires lui sera envoyé.
                    </RadzenText>
                </RadzenStack>

                <RadzenTemplateForm TItem="DTO_CreerSalarie" Data="_dto" Submit="Creer">
                    <RadzenStack Gap="1.25rem">

                        <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start><RadzenIcon Icon="mail" /></Start>
                            <ChildContent>
                                <RadzenTextBox @bind-Value="_dto.Email" Name="Email" Style="width: 100%;" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="Email" Text="L'email est obligatoire." />
                                <RadzenEmailValidator Component="Email" Text="Email invalide." />
                            </Helper>
                        </RadzenFormField>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Nom" Variant="Variant.Outlined" Style="width: 100%;">
                                    <Start><RadzenIcon Icon="badge" /></Start>
                                    <ChildContent>
                                        <RadzenTextBox @bind-Value="_dto.Nom" Name="Nom" Style="width: 100%;" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="Nom" Text="Obligatoire." />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Prénom" Variant="Variant.Outlined" Style="width: 100%;">
                                    <Start><RadzenIcon Icon="person" /></Start>
                                    <ChildContent>
                                        <RadzenTextBox @bind-Value="_dto.Prenom" Name="Prenom" Style="width: 100%;" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="Prenom" Text="Obligatoire." />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenFormField Text="Téléphone" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start><RadzenIcon Icon="phone" /></Start>
                            <ChildContent>
                                <RadzenTextBox @bind-Value="_dto.Telephone" Style="width: 100%;" Placeholder="Optionnel" />
                            </ChildContent>
                        </RadzenFormField>

                        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat">
                            Un mot de passe temporaire sera généré automatiquement et envoyé par email au collaborateur. Il pourra le changer via « Mon profil → Changer mon mot de passe » après sa première connexion.
                        </RadzenAlert>

                        <RadzenButton Text="Créer le compte collaborateur" ButtonType="ButtonType.Submit" Icon="person_add"
                                      ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                                      Style="width: 100%;" IsBusy="_enChargement" />
                    </RadzenStack>
                </RadzenTemplateForm>
            </RadzenCard>
        }
    </RadzenColumn>
</RadzenRow>

@code {
    private DTO_CreerSalarie _dto = new();
    private bool _enChargement;
    private bool _succes;
    private string _emailEnvoye = string.Empty;

    private async Task Creer()
    {
        _enChargement = true;
        var _email = _dto.Email;
        var (_ok, _message) = await SEntreprise.CreerSalarie(_dto);
        _enChargement = false;

        if (_ok)
        {
            _succes = true;
            _emailEnvoye = _email;
            Notification.Notify(NotificationSeverity.Success, "Succès", _message);
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private void Reinitialiser()
    {
        _dto = new DTO_CreerSalarie();
        _succes = false;
        _emailEnvoye = string.Empty;
    }
}
