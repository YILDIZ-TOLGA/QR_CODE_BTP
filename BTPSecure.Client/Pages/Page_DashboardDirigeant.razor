    private async Task RetirerCollaborateur(DTO_CollaborateurAffichage p_collaborateur)
    {
        var _confirm = await Dialog.Confirm(
            $"Retirer {p_collaborateur.Prenom} {p_collaborateur.Nom} de l'entreprise ? Ses codes actifs seront révoqués.",
            "Confirmer le retrait",
            new ConfirmOptions { OkButtonText = "Retirer", CancelButtonText = "Annuler" });
        if (_confirm == true)
        {
            var (_succes, _message) = await SEntreprise.RetirerCollaborateur(p_collaborateur.Id);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Success, "Succès", _message);
                await ChargerDonnees();
            }
            else
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private async Task ChangerRole(DTO_CollaborateurAffichage p_collaborateur, Enum_RoleEntreprise p_nouveauRole)
    {
        if (p_nouveauRole == p_collaborateur.RoleEntreprise)
        {
            return;
        }

        string _libelle = Services.H_RoleEntreprise.Libelle(p_nouveauRole);
        var _confirm = await Dialog.Confirm(
            $"Passer {p_collaborateur.Prenom} {p_collaborateur.Nom} au rôle « {_libelle} » ?",
            "Changer le rôle",
            new ConfirmOptions { OkButtonText = "Confirmer", CancelButtonText = "Annuler" });
        if (_confirm != true)
        {
            return;
        }

        var (_succes, _message) = await SEntreprise.ChangerRole(p_collaborateur.CollaborateurId, p_nouveauRole);
        if (_succes)
        {
            Notification.Notify(NotificationSeverity.Success, "Succès", _message);
            await ChargerDonnees();
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
