@page "/dirigeant"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Dirigeant,Collaborateur")]
@inject Services.S_Entreprise SEntreprise
@inject Services.S_Code SCode
@inject Services.S_FournisseurContact SFournisseur
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject NotificationService Notification
@inject DialogService Dialog

@if (_chargement)
{
    <RadzenRow JustifyContent="JustifyContent.Center" Style="margin-top: 4rem;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
    </RadzenRow>
}
else if (!_aAcces && !_estDirigeantSansEntreprise)
{
    <RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="min-height: 60vh;">
        <RadzenColumn Size="12" SizeMD="8" SizeLG="5">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 2rem 0;">
                    <RadzenIcon Icon="lock" Style="font-size: 3rem; color: var(--rz-danger);" />
                    <RadzenText TextStyle="TextStyle.H6" TextAlign="TextAlign.Center">Accès non autorisé</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" TextAlign="TextAlign.Center" Style="color: var(--rz-text-secondary-color);">
                        Ce tableau de bord est réservé au Dirigeant et aux Responsables Admin de l'entreprise.
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
}
else if (_estDirigeantSansEntreprise)
{
    <RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="min-height: 70vh;">
        <RadzenColumn Size="12" SizeMD="8" SizeLG="5">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="1.5rem" AlignItems="AlignItems.Center">
                    <RadzenIcon Icon="domain_add" Style="font-size: 3rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H4" TextAlign="TextAlign.Center">Créer votre entreprise</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle1" TextAlign="TextAlign.Center" Style="color: var(--rz-text-secondary-color); margin-top: -1rem;">
                        Commencez par enregistrer votre société
                    </RadzenText>

                    <RadzenTemplateForm TItem="DTO_CreerEntreprise" Data="_dtoEntreprise" Submit="CreerEntreprise" Style="width: 100%;">
                        <RadzenStack Gap="1.25rem">
                            <RadzenFormField Text="Nom de l'entreprise" Variant="Variant.Outlined" Style="width: 100%;">
                                <Start><RadzenIcon Icon="business" /></Start>
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="_dtoEntreprise.Nom" Name="NomEntreprise" Style="width: 100%;" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="NomEntreprise" Text="Le nom est obligatoire." />
                                </Helper>
                            </RadzenFormField>

                            <RadzenFormField Text="Adresse" Variant="Variant.Outlined" Style="width: 100%;">
                                <Start><RadzenIcon Icon="location_on" /></Start>
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="_dtoEntreprise.Adresse" Style="width: 100%;" Placeholder="Optionnel" />
                                </ChildContent>
                            </RadzenFormField>

                            <RadzenFormField Text="SIRET" Variant="Variant.Outlined" Style="width: 100%;">
                                <Start><RadzenIcon Icon="pin" /></Start>
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="_dtoEntreprise.Siret" Style="width: 100%;" Placeholder="Optionnel" />
                                </ChildContent>
                            </RadzenFormField>

                            <RadzenButton Text="Créer l'entreprise" ButtonType="ButtonType.Submit" Icon="rocket_launch"
                                          ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" Style="width: 100%;" />
                        </RadzenStack>
                    </RadzenTemplateForm>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
}
else
{
    <RadzenStack Gap="1.5rem">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <Comp_AutoRefresh OnRefresh="RafraichirUi" />
        </RadzenStack>

        @if (_estProprietaire && _nbNotifications > 0)
        {
            <RadzenCard Variant="Variant.Filled" Style="background: var(--rz-success); color: white; cursor: pointer;"
                        @onclick='() => Navigation.NavigateTo("/dirigeant/notifications")'>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                        <RadzenIcon Icon="notifications_active" Style="font-size: 2rem; color: white;" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: white;">
                                Vous avez @_nbNotifications commande(s) prête(s)
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: rgba(255,255,255,0.85);">
                                Cliquez pour voir le détail
                            </RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                    <RadzenIcon Icon="arrow_forward" Style="color: white;" />
                </RadzenStack>
            </RadzenCard>
        }

        @if (!_entreprise!.EstAutorisee)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat"
                         Title="Entreprise en attente d'autorisation">
                Votre entreprise n'est pas encore autorisée par l'administrateur. Vous ne pouvez pas créer de codes pour le moment.
            </RadzenAlert>
        }

        @* Accès permanent du dirigeant : mis en avant, sinon il se perdrait dans la liste des codes *@
        @if (_monCodePermanent != null)
        {
            <RadzenCard Variant="Variant.Filled" Style="background: var(--rz-primary); color: white;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                        <RadzenIcon Icon="vpn_key" Style="font-size: 2rem;" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; color: white; opacity: 0.9;">
                                Mon code permanent
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: white; opacity: 0.8;">
                                Libre-service, valable en permanence. Il change à chaque utilisation.
                            </RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: white; font-family: monospace; font-weight: 700; letter-spacing: 2px;">
                        @_monCodePermanent.Valeur
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        }

        <!-- En-tête entreprise -->
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenIcon Icon="business" Style="font-size: 2.5rem; color: var(--rz-primary);" />
                    <RadzenStack Gap="0">
                        <RadzenText TextStyle="TextStyle.H5" Style="margin: 0;">@_entreprise!.Nom</RadzenText>
                        @if (!string.IsNullOrEmpty(_entreprise.Siret))
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">SIRET : @_entreprise.Siret</RadzenText>
                        }
                        @if (!string.IsNullOrEmpty(_entreprise.Adresse))
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">@_entreprise.Adresse</RadzenText>
                        }
                    </RadzenStack>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    @if (_entreprise!.EstAutorisee)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Autorisée" IsPill="true" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="En attente" IsPill="true" />
                    }
                    @foreach (var _r in _rolesOrdre)
                    {
                        @if (CollaborateursDuRole(_r).Count > 0)
                        {
                            <RadzenBadge BadgeStyle="@Services.H_RoleEntreprise.Style(_r)"
                                         Text="@($"{CollaborateursDuRole(_r).Count} {Services.H_RoleEntreprise.LibellePluriel(_r)}")" IsPill="true" />
                        }
                    }
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@($"{_codes.Count(c => c.Statut == Enum_StatutCode.Actif)} code(s) actif(s)")" IsPill="true" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <!-- Collaborateurs -->
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom: 1rem;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="groups" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Collaborateurs</RadzenText>
                </RadzenStack>
                @if (_estProprietaire)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        <RadzenButton Text="Créer" Icon="person_add" ButtonStyle="ButtonStyle.Primary"
                                      Variant="Variant.Flat" Size="ButtonSize.Small" Click="OuvrirCreationCollaborateur" />
                        <RadzenButton Text="Inviter" Icon="person_search" ButtonStyle="ButtonStyle.Success"
                                      Variant="Variant.Flat" Size="ButtonSize.Small" Click="OuvrirAjoutCollaborateur" />
                    </RadzenStack>
                }
            </RadzenStack>

            @if (_collaborateurs.Count == 0)
            {
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 2rem 0;">
                    <RadzenIcon Icon="group_off" Style="font-size: 2.5rem; color: var(--rz-text-disabled-color);" />
                    <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">Aucun collaborateur pour le moment</RadzenText>
                </RadzenStack>
            }
            else
            {
                @foreach (var _role in _rolesOrdre)
                {
                    @if (CollaborateursDuRole(_role).Count > 0)
                    {
                        <RadzenStack Gap="0.5rem" Style="margin-bottom: 1.75rem;">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                <RadzenIcon Icon="@Services.H_RoleEntreprise.Icone(_role)"
                                            Style="@($"font-size: 1.4rem; color: {Services.H_RoleEntreprise.Couleur(_role)};")" />
                                <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; font-weight: 700;">
                                    @Services.H_RoleEntreprise.LibellePluriel(_role)
                                </RadzenText>
                                <RadzenBadge BadgeStyle="@Services.H_RoleEntreprise.Style(_role)"
                                             Text="@CollaborateursDuRole(_role).Count.ToString()" IsPill="true" />
                            </RadzenStack>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); margin: 0 0 0.5rem 0;">
                                @Services.H_RoleEntreprise.Description(_role)
                            </RadzenText>

                            <RadzenRow Gap="1rem">
                                @foreach (var _sal in CollaborateursDuRole(_role))
                                {
                                    <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                                        <RadzenCard Variant="Variant.Outlined"
                                                    Style="@($"height: 100%; border-left: 4px solid {Services.H_RoleEntreprise.Couleur(_sal.RoleEntreprise)};")">
                                            <RadzenStack Gap="0.75rem">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
                                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="min-width: 0; flex: 1;">
                                                        <RadzenIcon Icon="@Services.H_RoleEntreprise.Icone(_sal.RoleEntreprise)"
                                                                    Style="@($"font-size: 1.8rem; color: {Services.H_RoleEntreprise.Couleur(_sal.RoleEntreprise)};")" />
                                                        <RadzenText Style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@_sal.Prenom @_sal.Nom</RadzenText>
                                                    </RadzenStack>
                                                    @if (_sal.StatutInvitation == BTPSecure.Shared.Enums.Enum_StatutInvitation.Acceptee)
                                                    {
                                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Accepté" IsPill="true" />
                                                    }
                                                    else
                                                    {
                                                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="En attente de validation" IsPill="true" />
                                                    }
                                                </RadzenStack>

                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                    <RadzenIcon Icon="mail" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                                    <RadzenText TextStyle="TextStyle.Body2" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@_sal.Email</RadzenText>
                                                </RadzenStack>

                                                @if (_sal.StatutInvitation == BTPSecure.Shared.Enums.Enum_StatutInvitation.Acceptee)
                                                {
                                                    <RadzenButton Text="Envoyer un message" Icon="forum" ButtonStyle="ButtonStyle.Base"
                                                                  Variant="Variant.Outlined" Size="ButtonSize.Small" Style="width: 100%;"
                                                                  Click="@(() => EnvoyerMessageA($"{_sal.Prenom} {_sal.Nom}", _sal.CollaborateurId, _sal.Email))" />
                                                }

                                                @if (_estProprietaire && _sal.StatutInvitation == BTPSecure.Shared.Enums.Enum_StatutInvitation.Acceptee)
                                                {
                                                    <RadzenFormField Text="Rôle dans l'entreprise" Variant="Variant.Outlined" Style="width: 100%;">
                                                        <Start><RadzenIcon Icon="manage_accounts" /></Start>
                                                        <ChildContent>
                                                            <RadzenDropDown TValue="Enum_RoleEntreprise" Value="_sal.RoleEntreprise"
                                                                            Data="_rolesEntreprise" TextProperty="Text" ValueProperty="Value"
                                                                            Change="@(_args => ChangerRole(_sal, (Enum_RoleEntreprise)_args))"
                                                                            Style="width: 100%;" />
                                                        </ChildContent>
                                                    </RadzenFormField>
                                                }

                                                @if (_estProprietaire)
                                                {
                                                    <RadzenButton Text="Retirer" Icon="person_remove" ButtonStyle="ButtonStyle.Danger"
                                                                  Variant="Variant.Outlined" Size="ButtonSize.Small" Style="width: 100%;"
                                                                  Click="() => RetirerCollaborateur(_sal)" />
                                                }
                                            </RadzenStack>
                                        </RadzenCard>
                                    </RadzenColumn>
                                }
                            </RadzenRow>
                        </RadzenStack>
                    }
                }
            }
        </RadzenCard>

        <!-- Codes -->
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom: 1rem;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="qr_code_2" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Codes d'autorisation</RadzenText>
                </RadzenStack>
                @if (_entreprise!.EstAutorisee)
                {
                    <RadzenButton Text="Générer un code" Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                                  Variant="Variant.Flat" Size="ButtonSize.Small"
                                  Click='() => Navigation.NavigateTo("/dirigeant/creer-code")' />
                }
            </RadzenStack>

            @if (_codes.Count == 0)
            {
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 2rem 0;">
                    <RadzenIcon Icon="code_off" Style="font-size: 2.5rem; color: var(--rz-text-disabled-color);" />
                    <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">Aucun code créé</RadzenText>
                </RadzenStack>
            }
            else
            {
                <!-- Filtres -->
                <RadzenCard Variant="Variant.Filled" Style="background: var(--rz-base-100); margin-bottom: 1rem;">
                    <RadzenStack Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenIcon Icon="filter_alt" Style="color: var(--rz-primary);" />
                                <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; font-weight: 600;">Filtres</RadzenText>
                                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{_codesFiltres.Count} / {_codes.Count}")" IsPill="true" />
                            </RadzenStack>
                            <RadzenButton Text="Réinitialiser" Icon="restart_alt" ButtonStyle="ButtonStyle.Base"
                                          Variant="Variant.Text" Size="ButtonSize.Small" Click="ReinitialiserFiltres" />
                        </RadzenStack>

                        <RadzenFormField Text="Rechercher (référence, n° commande, code)" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start><RadzenIcon Icon="search" /></Start>
                            <ChildContent>
                                <RadzenTextBox Value="@_filtreRecherche" @oninput="MajRecherche" Style="width: 100%;"
                                               Placeholder="Ex : MaConstruction-20260715-203821" />
                            </ChildContent>
                        </RadzenFormField>

                        <RadzenRow Gap="0.75rem">
                            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                                <RadzenFormField Text="Type" Variant="Variant.Outlined" Style="width: 100%;">
                                    <Start><RadzenIcon Icon="category" /></Start>
                                    <ChildContent>
                                        <RadzenDropDown @bind-Value="_filtreType" Data="_optionsType" TextProperty="Text" ValueProperty="Value"
                                                        Style="width: 100%;" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                                <RadzenFormField Text="Statut" Variant="Variant.Outlined" Style="width: 100%;">
                                    <Start><RadzenIcon Icon="flag" /></Start>
                                    <ChildContent>
                                        <RadzenDropDown @bind-Value="_filtreStatut" Data="_optionsStatut" TextProperty="Text" ValueProperty="Value"
                                                        Style="width: 100%;" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                                <RadzenFormField Text="Collaborateur" Variant="Variant.Outlined" Style="width: 100%;">
                                    <Start><RadzenIcon Icon="person" /></Start>
                                    <ChildContent>
                                        <RadzenDropDown @bind-Value="_filtreCollaborateurId" Data="_optionsCollaborateur" TextProperty="Label" ValueProperty="Id"
                                                        Style="width: 100%;" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                                <RadzenFormField Text="Fournisseur" Variant="Variant.Outlined" Style="width: 100%;">
                                    <Start><RadzenIcon Icon="business" /></Start>
                                    <ChildContent>
                                        <RadzenDropDown @bind-Value="_filtreFournisseurId" Data="_optionsFournisseur" TextProperty="Label" ValueProperty="Id"
                                                        Style="width: 100%;" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                                <RadzenFormField Text="Créé après" Variant="Variant.Outlined" Style="width: 100%;">
                                    <Start><RadzenIcon Icon="event" /></Start>
                                    <ChildContent>
                                        <RadzenDatePicker @bind-Value="_filtreDateDebut" DateFormat="dd/MM/yyyy" Style="width: 100%;" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                                <RadzenFormField Text="Créé avant" Variant="Variant.Outlined" Style="width: 100%;">
                                    <Start><RadzenIcon Icon="event" /></Start>
                                    <ChildContent>
                                        <RadzenDatePicker @bind-Value="_filtreDateFin" DateFormat="dd/MM/yyyy" Style="width: 100%;" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </RadzenCard>

                @if (_codesFiltres.Count == 0)
                {
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 2rem 0;">
                        <RadzenIcon Icon="search_off" Style="font-size: 2.5rem; color: var(--rz-text-disabled-color);" />
                        <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">Aucun code ne correspond aux filtres</RadzenText>
                    </RadzenStack>
                }
                else
                {
                <RadzenRow Gap="1rem">
                    @foreach (var _c in _codesFiltres)
                    {
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                                <RadzenStack Gap="0.75rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                        @if (_c.TypeCode == Enum_TypeCode.LibreService)
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@Services.H_TypeCode.Libelle(_c.TypeCode)" IsPill="true" />
                                        }
                                        else
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@Services.H_TypeCode.Libelle(_c.TypeCode)" IsPill="true" />
                                        }
                                        <RadzenBadge BadgeStyle="@ObtenirStyleStatut(_c.Statut)" Text="@_c.Statut.ToString()" IsPill="true" />
                                    </RadzenStack>

                                    @* Valeur vide = code destiné à un collègue : le serveur ne l'envoie pas *@
                                    <RadzenCard Variant="Variant.Filled" Style="background: var(--rz-primary); padding: 0.75rem;">
                                        <RadzenText TextStyle="TextStyle.H4" TextAlign="TextAlign.Center"
                                                    Style="font-family: monospace; letter-spacing: 3px; color: white; margin: 0;">
                                            @ValeurAffichee(_c)
                                        </RadzenText>
                                        @if (string.IsNullOrEmpty(_c.Valeur))
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center"
                                                        Style="color: white; opacity: 0.85; margin: 0;">
                                                Visible uniquement par son destinataire
                                            </RadzenText>
                                        }
                                    </RadzenCard>

                                    <RadzenStack Gap="0.4rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="@(string.IsNullOrEmpty(_c.EmailTiers) ? "person" : "alternate_email")" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            @if (string.IsNullOrEmpty(_c.EmailTiers))
                                            {
                                                <RadzenText TextStyle="TextStyle.Body2">@_c.PrenomCollaborateur @_c.NomCollaborateur</RadzenText>
                                            }
                                            else
                                            {
                                                <RadzenText TextStyle="TextStyle.Body2">@_c.EmailTiers <span style="color: var(--rz-text-secondary-color);">(externe)</span></RadzenText>
                                            }
                                        </RadzenStack>
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="receipt_long" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Body2">@_c.NumeroCommande</RadzenText>
                                        </RadzenStack>
                                        @* Auteur du code : vide pour les codes antérieurs au suivi *@
                                        @if (!string.IsNullOrEmpty(_c.NomCreateur))
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                <RadzenIcon Icon="edit_note" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                    Créé par @_c.NomCreateur
                                                </RadzenText>
                                            </RadzenStack>
                                        }
                                        @if (_c.DateExpiration.HasValue)
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                <RadzenIcon Icon="schedule" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                    Expire le @_c.DateExpiration.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                </RadzenText>
                                            </RadzenStack>
                                        }
                                    </RadzenStack>

                                    @if (_c.Statut == Enum_StatutCode.Actif && PeutAgirSurCode(_c) && !EstMonCodePermanent(_c))
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                            @if (!_c.EstPermanent)
                                            {
                                                <RadzenButton Text="Modifier" Icon="edit" ButtonStyle="ButtonStyle.Base"
                                                              Variant="Variant.Outlined" Size="ButtonSize.Small" Style="flex: 1;"
                                                              Click="() => ModifierCode(_c)" />
                                            }
                                            <RadzenButton Text="Révoquer" Icon="block" ButtonStyle="ButtonStyle.Danger"
                                                          Variant="Variant.Outlined" Size="ButtonSize.Small" Style="flex: 1;"
                                                          Click="() => RevoquerCode(_c)" />
                                        </RadzenStack>
                                    }
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>
                    }
                </RadzenRow>
                }
            }
        </RadzenCard>
    </RadzenStack>
}

@code {
    private DTO_EntrepriseAffichage? _entreprise;
    private DTO_CreerEntreprise _dtoEntreprise = new();
    private List<DTO_CollaborateurAffichage> _collaborateurs = new();

    // Ordre d'affichage des sections : Responsable Admin, puis Responsable, puis Collaborateur
    private static readonly Enum_RoleEntreprise[] _rolesOrdre = new[]
    {
        Enum_RoleEntreprise.ResponsableAdmin,
        Enum_RoleEntreprise.Responsable,
        Enum_RoleEntreprise.Collaborateur
    };

    // Collaborateurs d'un rôle donné (chaque rôle a sa propre section)
    private List<DTO_CollaborateurAffichage> CollaborateursDuRole(Enum_RoleEntreprise p_role)
    {
        return _collaborateurs
            .Where(c => c.RoleEntreprise == p_role)
            .OrderBy(c => c.Nom)
            .ToList();
    }

    private List<object> _rolesEntreprise = new()
    {
        new { Text = "Collaborateur", Value = Enum_RoleEntreprise.Collaborateur },
        new { Text = "Responsable", Value = Enum_RoleEntreprise.Responsable },
        new { Text = "Responsable Admin", Value = Enum_RoleEntreprise.ResponsableAdmin }
    };
    private List<DTO_CodeAffichage> _codes = new();
    private List<DTO_FournisseurContact> _fournisseurs = new();
    private int _nbNotifications = 0;
    private bool _chargement = true;
    private bool _estProprietaire = true;
    private DTO_CodeAffichage? _monCodePermanent;
    private bool _aAcces = false;
    private bool _estDirigeantSansEntreprise = false;

    // Filtres
    private string _filtreType = "tous";
    private string _filtreStatut = "tous";
    private int _filtreCollaborateurId = 0;
    private int _filtreFournisseurId = 0;
    private DateTime? _filtreDateDebut;
    private DateTime? _filtreDateFin;

    private List<object> _optionsType = new()
    {
        new { Text = "Tous", Value = "tous" },
        new { Text = "Libre-service", Value = "libreservice" },
        new { Text = "Liste", Value = "liste" }
    };

    private List<object> _optionsStatut = new()
    {
        new { Text = "Tous", Value = "tous" },
        new { Text = "Actif", Value = "actif" },
        new { Text = "Utilisé", Value = "utilise" },
        new { Text = "Révoqué", Value = "revoque" },
        new { Text = "Expiré", Value = "expire" }
    };

    private List<OptionItem> _optionsCollaborateur => new List<OptionItem> { new() { Id = 0, Label = "Tous" } }
        .Concat(_collaborateurs.Select(s => new OptionItem { Id = s.CollaborateurId, Label = $"{s.Prenom} {s.Nom}" })).ToList();

    private List<OptionItem> _optionsFournisseur => new List<OptionItem> { new() { Id = 0, Label = "Tous" } }
        .Concat(_fournisseurs.Select(f => new OptionItem { Id = f.Id, Label = f.NomEntreprise })).ToList();

    private List<DTO_CodeAffichage> _codesFiltres
    {
        get
        {
            IEnumerable<DTO_CodeAffichage> _q = _codes;

            if (!string.IsNullOrWhiteSpace(_filtreRecherche))
            {
                var _r = _filtreRecherche.Trim().ToLower();
                _q = _q.Where(c =>
                    (c.Reference != null && c.Reference.ToLower().Contains(_r))
                    || c.NumeroCommande.ToLower().Contains(_r)
                    || c.Valeur.ToLower().Contains(_r));
            }

            if (_filtreType == "libreservice")
                _q = _q.Where(c => c.TypeCode == Enum_TypeCode.LibreService);
            else if (_filtreType == "liste")
                _q = _q.Where(c => c.TypeCode == Enum_TypeCode.Liste);

            if (_filtreStatut == "actif")
                _q = _q.Where(c => c.Statut == Enum_StatutCode.Actif);
            else if (_filtreStatut == "utilise")
                _q = _q.Where(c => c.Statut == Enum_StatutCode.Utilise);
            else if (_filtreStatut == "revoque")
                _q = _q.Where(c => c.Statut == Enum_StatutCode.Revoque);
            else if (_filtreStatut == "expire")
                _q = _q.Where(c => c.Statut == Enum_StatutCode.Expire);

            if (_filtreCollaborateurId > 0)
                _q = _q.Where(c => c.CollaborateurId == _filtreCollaborateurId);

            if (_filtreFournisseurId > 0)
                _q = _q.Where(c => c.FournisseurContactId == _filtreFournisseurId);

            if (_filtreDateDebut.HasValue)
            {
                var _debut = _filtreDateDebut.Value.Date.ToUniversalTime();
                _q = _q.Where(c => c.DateCreation >= _debut);
            }
            if (_filtreDateFin.HasValue)
            {
                var _fin = _filtreDateFin.Value.Date.AddDays(1).ToUniversalTime();
                _q = _q.Where(c => c.DateCreation < _fin);
            }

            return _q.ToList();
        }
    }

    private class OptionItem
    {
        public int Id { get; set; }
        public string Label { get; set; } = string.Empty;
    }

    private string _filtreRecherche = string.Empty;

    // Liaison à la frappe : l'auto-refresh 60 s ne doit pas effacer la saisie
    private void MajRecherche(ChangeEventArgs p_e)
    {
        if (p_e.Value == null)
        {
            _filtreRecherche = string.Empty;
            return;
        }
        var _s = p_e.Value.ToString();
        if (_s == null)
            _filtreRecherche = string.Empty;
        else
            _filtreRecherche = _s;
    }

    private void ReinitialiserFiltres()
    {
        _filtreRecherche = string.Empty;
        _filtreType = "tous";
        _filtreStatut = "tous";
        _filtreCollaborateurId = 0;
        _filtreFournisseurId = 0;
        _filtreDateDebut = null;
        _filtreDateFin = null;
    }

    private int _userId = 0;

    // Miroir de la règle serveur (S_Code.VerifierDroitSurCode) : le Dirigeant agit sur
    // tous les codes de son entreprise, un Responsable Admin sur ceux dont il est l'auteur.
    // Le serveur retire la valeur des codes destinés à un collègue (le code est un porteur)
    private static string ValeurAffichee(DTO_CodeAffichage p_code)
    {
        if (string.IsNullOrEmpty(p_code.Valeur))
        {
            return "••••-••••";
        }
        return p_code.Valeur;
    }

    // Son propre code permanent n'est ni modifiable ni révocable : il serait recréé aussitôt
    private bool EstMonCodePermanent(DTO_CodeAffichage p_code)
    {
        if (!p_code.EstPermanent)
        {
            return false;
        }
        return p_code.CollaborateurId == _userId;
    }

    private bool PeutAgirSurCode(DTO_CodeAffichage p_code)
    {
        if (_estProprietaire)
        {
            return true;
        }
        return p_code.CreateurId.HasValue && p_code.CreateurId.Value == _userId;
    }

    protected override async Task OnInitializedAsync()
    {
        var _etat = await AuthState.GetAuthenticationStateAsync();
        var _claimId = _etat.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (_claimId != null)
        {
            int.TryParse(_claimId.Value, out _userId);
        }

        try
        {
            await ChargerDonnees();
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task RafraichirUi()
    {
        try
        {
            await ChargerDonnees();
            StateHasChanged();
        }
        catch { }
    }

    private async Task ChargerDonnees()
    {
        var _ctx = await SCode.ObtenirContexteDashboard();
        _aAcces = _ctx.AAcces;
        _estProprietaire = _ctx.EstProprietaire;
        _estDirigeantSansEntreprise = _ctx.EstDirigeantSansEntreprise;
        _entreprise = _ctx.Entreprise;
        _collaborateurs = _ctx.Collaborateurs;
        _codes = _ctx.Codes;
        _fournisseurs = _ctx.Fournisseurs;
        _nbNotifications = _ctx.NbNotifications;

        _monCodePermanent = null;
        foreach (var _c in _codes)
        {
            if (_c.EstPermanent && _c.CollaborateurId == _userId && _c.Statut == Enum_StatutCode.Actif)
            {
                _monCodePermanent = _c;
            }
        }
    }

    private async Task CreerEntreprise()
    {
        var (_succes, _message, _) = await SEntreprise.Creer(_dtoEntreprise);
        if (_succes)
        {
            Notification.Notify(NotificationSeverity.Success, "Succès", _message);
            await ChargerDonnees();
        }
        else
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
