    // Message rapide vers un utilisateur depuis sa fiche
    private async Task EnvoyerMessageA(string p_nom, int? p_destinataireId, string? p_email)
    {
        var _params = new Dictionary<string, object?>
        {
            ["NomDestinataire"] = p_nom,
            ["DestinataireId"] = p_destinataireId,
            ["EmailDestinataire"] = p_email
        };

        await Dialog.OpenAsync<Comp_DialogEnvoyerMessage>($"Message à {p_nom}", _params,
            new DialogOptions { Width = "560px", CloseDialogOnOverlayClick = true });
    }

    // Réattribue un code à un autre destinataire et/ou un autre fournisseur
    private async Task ModifierCode(DTO_CodeAffichage p_code)
    {
        var _options = _collaborateurs
            .Where(c => c.StatutInvitation == Enum_StatutInvitation.Acceptee)
            .Select(c => new Comp_DialogModifierCode.OptionCollaborateur
            {
                Id = c.CollaborateurId,
                Label = $"{c.Prenom} {c.Nom} ({c.Email})"
            })
            .ToList();

        int? _collaborateurActuel = null;
        if (p_code.CollaborateurId > 0)
            _collaborateurActuel = p_code.CollaborateurId;

        var _params = new Dictionary<string, object?>
        {
            ["CodeId"] = p_code.Id,
            ["CollaborateurIdActuel"] = _collaborateurActuel,
            ["EmailTiersActuel"] = p_code.EmailTiers,
            ["FournisseurContactIdActuel"] = p_code.FournisseurContactId,
            ["Collaborateurs"] = _options,
            ["Fournisseurs"] = _fournisseurs
        };

        var _resultat = await Dialog.OpenAsync<Comp_DialogModifierCode>($"Modifier le code {p_code.Valeur}", _params,
            new DialogOptions { Width = "560px", CloseDialogOnOverlayClick = true });

        if (_resultat is DTO_ModifierCode _dtoModif)
        {
            var (_succes, _message, _res) = await SCode.Modifier(_dtoModif);
            if (_succes)
            {
                var _severite = NotificationSeverity.Success;
                if (_res != null && _res.CodeRegenere)
                    _severite = NotificationSeverity.Warning;

                Notification.Notify(_severite, "Code modifié", _message, 8000);
                _codes = await SCode.ObtenirParDirigeant();
            }
            else
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private static BadgeStyle ObtenirStyleStatut(Enum_StatutCode p_statut)
    {
        if (p_statut == Enum_StatutCode.Actif)
        {
            return BadgeStyle.Success;
        }
        if (p_statut == Enum_StatutCode.Utilise)
        {
            return BadgeStyle.Info;
        }
        if (p_statut == Enum_StatutCode.Expire)
        {
            return BadgeStyle.Light;
        }
        if (p_statut == Enum_StatutCode.Revoque)
        {
            return BadgeStyle.Danger;
        }
        return BadgeStyle.Light;
    }
