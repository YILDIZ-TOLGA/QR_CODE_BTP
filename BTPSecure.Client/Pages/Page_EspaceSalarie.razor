@page "/salarie"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Salarie")]
@inject Services.S_Code SCode
@inject Services.S_Invitation SInvitation
@inject NotificationService Notification
@inject DialogService Dialog

@if (_chargement)
{
    <RadzenRow JustifyContent="JustifyContent.Center" Style="margin-top: 4rem;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
    </RadzenRow>
}
else
{
    <RadzenStack Gap="1.5rem">

        @* ===== INVITATIONS EN ATTENTE ===== *@
        @if (_invitationsEnAttente.Count > 0)
        {
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1rem;">
                    <RadzenIcon Icon="mail" Style="font-size: 1.5rem; color: var(--rz-warning);" />
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Invitations en attente (@_invitationsEnAttente.Count)</RadzenText>
                </RadzenStack>

                <RadzenRow Gap="1rem">
                    @foreach (var _inv in _invitationsEnAttente)
                    {
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenCard Variant="Variant.Outlined" Style="border-color: var(--rz-warning); height: 100%;">
                                <RadzenStack Gap="1rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                        <RadzenIcon Icon="business" Style="font-size: 2rem; color: var(--rz-primary);" />
                                        <RadzenStack Gap="0">
                                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">@_inv.NomEntreprise</RadzenText>
                                            @if (!string.IsNullOrEmpty(_inv.SiretEntreprise))
                                            {
                                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">SIRET : @_inv.SiretEntreprise</RadzenText>
                                            }
                                        </RadzenStack>
                                    </RadzenStack>

                                    <RadzenStack Gap="0.25rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="person" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Body2">Patron : @_inv.PrenomPatron @_inv.NomPatron</RadzenText>
                                        </RadzenStack>
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="schedule" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                Reçue le @_inv.DateAjout.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </RadzenText>
                                        </RadzenStack>
                                    </RadzenStack>

                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                        <RadzenButton Text="Accepter" Icon="check" ButtonStyle="ButtonStyle.Success"
                                                      Style="flex: 1;" Size="ButtonSize.Small"
                                                      Click="() => AccepterInvitation(_inv)" />
                                        <RadzenButton Text="Refuser" Icon="close" ButtonStyle="ButtonStyle.Danger"
                                                      Variant="Variant.Outlined" Style="flex: 1;" Size="ButtonSize.Small"
                                                      Click="() => RefuserInvitation(_inv)" />
                                    </RadzenStack>
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>
                    }
                </RadzenRow>
            </RadzenCard>
        }

        @* ===== MES ENTREPRISES ===== *@
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1rem;">
                <RadzenIcon Icon="business_center" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Mes entreprises</RadzenText>
            </RadzenStack>

            @if (_entreprisesAcceptees.Count == 0)
            {
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 2rem 0;">
                    <RadzenIcon Icon="domain_disabled" Style="font-size: 2.5rem; color: var(--rz-text-disabled-color);" />
                    <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">
                        Vous n'appartenez à aucune entreprise pour le moment.
                    </RadzenText>
                </RadzenStack>
            }
            else
            {
                <RadzenRow Gap="1rem">
                    @foreach (var _ent in _entreprisesAcceptees)
                    {
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                                <RadzenStack Gap="0.75rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                        <RadzenIcon Icon="business" Style="font-size: 2rem; color: var(--rz-primary);" />
                                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; font-weight: 600;">@_ent.NomEntreprise</RadzenText>
                                    </RadzenStack>

                                    <RadzenStack Gap="0.4rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="person" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Body2">Patron : @_ent.PrenomPatron @_ent.NomPatron</RadzenText>
                                        </RadzenStack>
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="event" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                Membre depuis le @_ent.DateAjout.ToLocalTime().ToString("dd/MM/yyyy")
                                            </RadzenText>
                                        </RadzenStack>
                                    </RadzenStack>

                                    <RadzenButton Text="Quitter l'entreprise" Icon="exit_to_app" ButtonStyle="ButtonStyle.Danger"
                                                  Variant="Variant.Outlined" Size="ButtonSize.Small" Style="width: 100%;"
                                                  Click="() => QuitterEntreprise(_ent)" />
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>
                    }
                </RadzenRow>
            }
        </RadzenCard>

        @* ===== MES CODES ===== *@
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-top: 0.5rem;">
            <RadzenIcon Icon="qr_code" Style="font-size: 1.5rem; color: var(--rz-primary);" />
            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Mes codes d'achat</RadzenText>
        </RadzenStack>

        @if (_codes.Count == 0)
        {
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 2rem 0;">
                    <RadzenIcon Icon="code_off" Style="font-size: 2.5rem; color: var(--rz-text-disabled-color);" />
                    <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">Aucun code actif</RadzenText>
                </RadzenStack>
            </RadzenCard>
        }
        else
        {
            <RadzenRow Gap="1rem">
                @foreach (var _code in _codes)
                {
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                        <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                            <RadzenStack Gap="1rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenBadge BadgeStyle="@(_code.TypeCode == Enum_TypeCode.Confiance ? BadgeStyle.Info : BadgeStyle.Warning)"
                                                 Text="@_code.TypeCode.ToString()" IsPill="true" />
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Actif" IsPill="true" />
                                </RadzenStack>

                                <RadzenCard Variant="Variant.Filled" Style="background: var(--rz-primary);">
                                    <RadzenText TextStyle="TextStyle.H3" TextAlign="TextAlign.Center"
                                                Style="font-family: monospace; letter-spacing: 4px; color: white; margin: 0;">
                                        @_code.Valeur
                                    </RadzenText>
                                </RadzenCard>

                                <RadzenStack Gap="0.4rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="business" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                        <RadzenText TextStyle="TextStyle.Body2">@_code.NomEntreprise</RadzenText>
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        <RadzenIcon Icon="receipt_long" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                        <RadzenText TextStyle="TextStyle.Body2">@_code.NumeroCommande</RadzenText>
                                    </RadzenStack>
                                    @if (!string.IsNullOrEmpty(_code.ListeMateriaux))
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Start">
                                            <RadzenIcon Icon="inventory" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Body2">@_code.ListeMateriaux</RadzenText>
                                        </RadzenStack>
                                    }
                                    @if (_code.DateExpiration.HasValue)
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="schedule" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                Expire le @_code.DateExpiration.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </RadzenText>
                                        </RadzenStack>
                                    }
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>
        }
    </RadzenStack>
}

@code {
    private List<DTO_InvitationAffichage> _invitations = new();
    private List<DTO_InvitationAffichage> _invitationsEnAttente => _invitations.Where(i => i.Statut == BTPSecure.Shared.Enums.Enum_StatutInvitation.EnAttente).ToList();
    private List<DTO_InvitationAffichage> _entreprisesAcceptees => _invitations.Where(i => i.Statut == BTPSecure.Shared.Enums.Enum_StatutInvitation.Acceptee).ToList();
    private List<DTO_CodeAffichage> _codes = new();
    private bool _chargement = true;

    protected override async Task OnInitializedAsync()
    {
        await ChargerDonnees();
        _chargement = false;
    }

    private async Task ChargerDonnees()
    {
        _invitations = await SInvitation.ObtenirInvitations();
        _codes = await SCode.ObtenirParSalarie();
    }

    private async Task AccepterInvitation(DTO_InvitationAffichage p_inv)
    {
        var (_succes, _message) = await SInvitation.Accepter(p_inv.Id);
        if (_succes)
        {
            Notification.Notify(NotificationSeverity.Success, "Bienvenue", _message);
            await ChargerDonnees();
        }
        else
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
    }

    private async Task RefuserInvitation(DTO_InvitationAffichage p_inv)
    {
        var _confirm = await Dialog.Confirm(
            $"Refuser l'invitation de « {p_inv.NomEntreprise} » ?",
            "Confirmer le refus",
            new ConfirmOptions { OkButtonText = "Refuser", CancelButtonText = "Annuler" });

        if (_confirm == true)
        {
            var (_succes, _message) = await SInvitation.Refuser(p_inv.Id);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Info, "Info", _message);
                await ChargerDonnees();
            }
            else
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private async Task QuitterEntreprise(DTO_InvitationAffichage p_inv)
    {
        var _confirm = await Dialog.Confirm(
            $"Quitter l'entreprise « {p_inv.NomEntreprise} » ? Vos codes actifs liés seront révoqués.",
            "Confirmer le départ",
            new ConfirmOptions { OkButtonText = "Quitter", CancelButtonText = "Annuler" });

        if (_confirm == true)
        {
            var (_succes, _message) = await SInvitation.Quitter(p_inv.Id);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Success, "Terminé", _message);
                await ChargerDonnees();
            }
            else
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }
}
