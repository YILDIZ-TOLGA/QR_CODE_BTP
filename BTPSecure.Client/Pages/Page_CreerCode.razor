@page "/dirigeant/creer-code"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Dirigeant")]
@inject Services.S_Code SCode
@inject Services.S_Entreprise SEntreprise
@inject Services.S_FournisseurContact SFournisseur
@inject NavigationManager Navigation
@inject NotificationService Notification

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1.5rem;">
    <RadzenButton Icon="arrow_back" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Large"
                  Click='() => Navigation.NavigateTo("/dirigeant")' />
    <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Créer un code d'autorisation</RadzenText>
</RadzenStack>

<RadzenRow JustifyContent="JustifyContent.Center">
    <RadzenColumn Size="12" SizeMD="8" SizeLG="6">
        @if (_codeGenere != null)
        {
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="1.5rem" AlignItems="AlignItems.Center">
                    <RadzenIcon Icon="check_circle" Style="font-size: 4rem; color: var(--rz-success);" />
                    <RadzenText TextStyle="TextStyle.H5" TextAlign="TextAlign.Center" Style="color: var(--rz-success);">
                        Code créé avec succès
                    </RadzenText>

                    <RadzenCard Variant="Variant.Filled" Style="background: var(--rz-primary); width: 100%;">
                        <RadzenText TextStyle="TextStyle.H2" TextAlign="TextAlign.Center"
                                    Style="font-family: monospace; letter-spacing: 6px; color: white; margin: 0.5rem 0;">
                            @_codeGenere.Valeur
                        </RadzenText>
                    </RadzenCard>

                    <RadzenStack Gap="0.5rem" Style="width: 100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText Style="color: var(--rz-text-secondary-color);">Collaborateur</RadzenText>
                            <RadzenText Style="font-weight: 600;">@_codeGenere.PrenomCollaborateur @_codeGenere.NomCollaborateur</RadzenText>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText Style="color: var(--rz-text-secondary-color);">Commande</RadzenText>
                            <RadzenText Style="font-weight: 600;">@_codeGenere.NumeroCommande</RadzenText>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText Style="color: var(--rz-text-secondary-color);">Type</RadzenText>
                            <RadzenBadge BadgeStyle="@(_codeGenere.TypeCode == Enum_TypeCode.LibreService ? BadgeStyle.Info : BadgeStyle.Warning)"
                                         Text="@_codeGenere.TypeCode.ToString()" IsPill="true" />
                        </RadzenStack>
                        @if (_codeGenere.DateExpiration.HasValue)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenText Style="color: var(--rz-text-secondary-color);">Expiration</RadzenText>
                                <RadzenText Style="font-weight: 600;">@_codeGenere.DateExpiration.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</RadzenText>
                            </RadzenStack>
                        }
                        @if (!string.IsNullOrEmpty(_codeGenere.NomFournisseurContact))
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenText Style="color: var(--rz-text-secondary-color);">Fournisseur</RadzenText>
                                <RadzenText Style="font-weight: 600;">@_codeGenere.NomFournisseurContact</RadzenText>
                            </RadzenStack>
                        }
                        @if (!string.IsNullOrEmpty(_codeGenere.Reference))
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenText Style="color: var(--rz-text-secondary-color);">Référence</RadzenText>
                                <RadzenText Style="font-weight: 600; font-family: monospace; font-size: 0.85rem;">@_codeGenere.Reference</RadzenText>
                            </RadzenStack>
                        }
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Style="width: 100%;">
                        <RadzenButton Text="Créer un autre" Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                                      Variant="Variant.Outlined" Style="flex: 1;" Click="Reinitialiser" />
                        <RadzenButton Text="Tableau de bord" Icon="dashboard" ButtonStyle="ButtonStyle.Primary"
                                      Style="flex: 1;" Click='() => Navigation.NavigateTo("/dirigeant")' />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        }
        else
        {
            <RadzenCard Variant="Variant.Outlined">
                <RadzenTemplateForm TItem="DTO_CreerCode" Data="_dto" Submit="Creer">
                    <RadzenStack Gap="1.25rem">
                        <RadzenFormField Text="Collaborateur" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start><RadzenIcon Icon="person" /></Start>
                            <ChildContent>
                                <RadzenDropDown @bind-Value="_dto.CollaborateurId" Data="_collaborateurs" TextProperty="Label"
                                                ValueProperty="CollaborateurId" Name="Collaborateur" Style="width: 100%;"
                                                Placeholder="Sélectionner un collaborateur..." />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="Collaborateur" Text="Le collaborateur est obligatoire." DefaultValue="0" />
                            </Helper>
                        </RadzenFormField>

                        <RadzenFormField Text="Numéro de commande" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start><RadzenIcon Icon="receipt_long" /></Start>
                            <ChildContent>
                                <RadzenTextBox @bind-Value="_dto.NumeroCommande" Name="NumCmd" Style="width: 100%;" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="NumCmd" Text="Le numéro de commande est obligatoire." />
                            </Helper>
                        </RadzenFormField>

                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.Subtitle2">Type de code</RadzenText>
                            <RadzenSelectBar @bind-Value="_dto.TypeCode" TValue="Enum_TypeCode" Size="ButtonSize.Medium" Style="width: 100%;">
                                <Items>
                                    <RadzenSelectBarItem Text="LibreService" Value="Enum_TypeCode.LibreService" Icon="schedule" />
                                    <RadzenSelectBarItem Text="Liste matériaux" Value="Enum_TypeCode.Liste" Icon="list_alt" />
                                </Items>
                            </RadzenSelectBar>
                        </RadzenStack>

                        @if (_dto.TypeCode == Enum_TypeCode.LibreService)
                        {
                            <RadzenCard Variant="Variant.Filled" Style="background: var(--rz-info-light); padding: 0.75rem;">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenIcon Icon="timer" Style="color: var(--rz-info);" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                                        <strong>Validité : 48 heures</strong> à partir de la création
                                    </RadzenText>
                                </RadzenStack>
                            </RadzenCard>
                        }

                        @if (_dto.TypeCode == Enum_TypeCode.Liste)
                        {
                            <RadzenFormField Text="Liste des matériaux" Variant="Variant.Outlined" Style="width: 100%;">
                                <Start><RadzenIcon Icon="inventory" /></Start>
                                <ChildContent>
                                    <RadzenTextArea @bind-Value="_dto.ListeMateriaux" Rows="4" Name="Materiaux" Style="width: 100%;"
                                                    Placeholder="Ex: 10 sacs de ciment, 5 plaques de plâtre..." />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="Materiaux" Text="La liste des matériaux est obligatoire." />
                                </Helper>
                            </RadzenFormField>
                        }

                        <RadzenFormField Text="Informations complémentaires" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start><RadzenIcon Icon="info" /></Start>
                            <ChildContent>
                                <RadzenTextArea @bind-Value="_dto.Info" Rows="2" Style="width: 100%;" Placeholder="Optionnel" />
                            </ChildContent>
                        </RadzenFormField>

                        <RadzenStack Gap="0.5rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenCheckBox @bind-Value="_dto.UtiliserFournisseur" Name="UseFour" />
                                <RadzenLabel Text="Choisir un fournisseur" Component="UseFour" />
                            </RadzenStack>

                            @if (_dto.UtiliserFournisseur)
                            {
                                <RadzenCard Variant="Variant.Filled" Style="background: var(--rz-base-100); padding: 1rem;">
                                    <RadzenStack Gap="1rem">
                                        <RadzenSelectBar @bind-Value="_modeFournisseur" TValue="string" Size="ButtonSize.Small" Style="width: 100%;">
                                            <Items>
                                                <RadzenSelectBarItem Text="Existant" Value="@("existant")" Icon="contacts" />
                                                <RadzenSelectBarItem Text="Nouveau" Value="@("nouveau")" Icon="person_add" />
                                            </Items>
                                        </RadzenSelectBar>

                                        @if (_modeFournisseur == "existant")
                                        {
                                            @if (_fournisseurs.Count == 0)
                                            {
                                                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                                                    Aucun fournisseur dans votre carnet. Ajoutez-en un via « Mes fournisseurs » ou choisissez « Nouveau ».
                                                </RadzenText>
                                            }
                                            else
                                            {
                                                <RadzenFormField Text="Fournisseur" Variant="Variant.Outlined" Style="width: 100%;">
                                                    <Start><RadzenIcon Icon="business" /></Start>
                                                    <ChildContent>
                                                        <RadzenDropDown @bind-Value="_dto.FournisseurContactId" Data="_fournisseurs"
                                                                        TextProperty="NomEntreprise" ValueProperty="Id" Style="width: 100%;"
                                                                        Placeholder="Sélectionner un fournisseur..." />
                                                    </ChildContent>
                                                </RadzenFormField>
                                            }
                                        }
                                        else
                                        {
                                            <RadzenFormField Text="Nom de l'entreprise" Variant="Variant.Outlined" Style="width: 100%;">
                                                <Start><RadzenIcon Icon="business" /></Start>
                                                <ChildContent>
                                                    <RadzenTextBox @bind-Value="_dto.NouveauFournisseurNomEntreprise" Style="width: 100%;" />
                                                </ChildContent>
                                            </RadzenFormField>

                                            <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width: 100%;">
                                                <Start><RadzenIcon Icon="mail" /></Start>
                                                <ChildContent>
                                                    <RadzenTextBox @bind-Value="_dto.NouveauFournisseurEmail" Style="width: 100%;" />
                                                </ChildContent>
                                            </RadzenFormField>

                                            <RadzenFormField Text="SIRET (14 chiffres)" Variant="Variant.Outlined" Style="width: 100%;">
                                                <Start><RadzenIcon Icon="pin" /></Start>
                                                <ChildContent>
                                                    <RadzenTextBox @bind-Value="_dto.NouveauFournisseurSiret" Style="width: 100%;" Placeholder="12345678901234" />
                                                </ChildContent>
                                            </RadzenFormField>

                                            <RadzenFormField Text="SIREN (9 chiffres, optionnel)" Variant="Variant.Outlined" Style="width: 100%;">
                                                <Start><RadzenIcon Icon="pin" /></Start>
                                                <ChildContent>
                                                    <RadzenTextBox @bind-Value="_dto.NouveauFournisseurSiren" Style="width: 100%;" Placeholder="Optionnel" />
                                                </ChildContent>
                                            </RadzenFormField>

                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                Ce fournisseur sera ajouté à votre carnet pour réutilisation future.
                                            </RadzenText>
                                        }
                                    </RadzenStack>
                                </RadzenCard>
                            }
                        </RadzenStack>

                        <RadzenButton Text="Générer le code" ButtonType="ButtonType.Submit" Icon="qr_code_2"
                                      ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                                      Style="width: 100%;" IsBusy="_enChargement" />
                    </RadzenStack>
                </RadzenTemplateForm>
            </RadzenCard>
        }
    </RadzenColumn>
</RadzenRow>

@code {
    private DTO_CreerCode _dto = new() { TypeCode = Enum_TypeCode.LibreService };
    private DTO_CodeAffichage? _codeGenere;
    private bool _enChargement;
    private List<CollaborateurItem> _collaborateurs = new();
    private DTO_EntrepriseAffichage? _entreprise;
    private List<DTO_FournisseurContact> _fournisseurs = new();
    private string _modeFournisseur = "existant";

    private const int DUREE_CONFIANCE_HEURES = 48;

    protected override async Task OnInitializedAsync()
    {
        _entreprise = await SEntreprise.ObtenirMonEntreprise();
        if (_entreprise != null)
        {
            _dto.EntrepriseId = _entreprise.Id;
            var _listeCollaborateurs = await SEntreprise.ObtenirCollaborateurs();
            _collaborateurs = _listeCollaborateurs.Select(s => new CollaborateurItem
            {
                CollaborateurId = s.CollaborateurId,
                Label = $"{s.Prenom} {s.Nom} ({s.Email})"
            }).ToList();
        }
        _fournisseurs = await SFournisseur.Lister();
    }

    private async Task Creer()
    {
        _enChargement = true;

        if (_dto.TypeCode == Enum_TypeCode.LibreService)
        {
            _dto.DureeValiditeHeures = DUREE_CONFIANCE_HEURES;
        }

        if (_dto.UtiliserFournisseur)
        {
            if (_modeFournisseur == "existant")
            {
                _dto.NouveauFournisseurNomEntreprise = null;
                _dto.NouveauFournisseurEmail = null;
                _dto.NouveauFournisseurSiret = null;
                _dto.NouveauFournisseurSiren = null;
            }
            else
            {
                _dto.FournisseurContactId = null;
            }
        }
        else
        {
            _dto.FournisseurContactId = null;
            _dto.NouveauFournisseurNomEntreprise = null;
            _dto.NouveauFournisseurEmail = null;
            _dto.NouveauFournisseurSiret = null;
            _dto.NouveauFournisseurSiren = null;
        }

        var (_succes, _message, _code) = await SCode.Creer(_dto);
        _enChargement = false;

        if (_succes)
        {
            _codeGenere = _code;
            Notification.Notify(NotificationSeverity.Success, "Succès", _message);
        }
        else
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
    }

    private void Reinitialiser()
    {
        _codeGenere = null;
        _dto = new DTO_CreerCode { TypeCode = Enum_TypeCode.LibreService, EntrepriseId = _entreprise?.Id ?? 0 };
        _modeFournisseur = "existant";
    }

    private class CollaborateurItem
    {
        public int CollaborateurId { get; set; }
        public string Label { get; set; } = string.Empty;
    }
}
