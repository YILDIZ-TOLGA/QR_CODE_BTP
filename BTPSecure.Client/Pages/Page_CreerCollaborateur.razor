@page "/dirigeant/creer-collaborateur"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Dirigeant")]
@inject NavigationManager Navigation

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1.5rem;">
    <RadzenButton Icon="arrow_back" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Large"
                  Click='() => Navigation.NavigateTo("/dirigeant")' />
    <RadzenIcon Icon="person_add" Style="font-size: 2rem; color: var(--rz-primary);" />
    <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Création d'un collaborateur</RadzenText>
</RadzenStack>

<RadzenRow JustifyContent="JustifyContent.Center">
    <RadzenColumn Size="12" SizeMD="8" SizeLG="6">
        @if (_succes)
        {
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="1.5rem" AlignItems="AlignItems.Center">
                    <RadzenIcon Icon="check_circle" Style="font-size: 4rem; color: var(--rz-success);" />
                    <RadzenText TextStyle="TextStyle.H5" TextAlign="TextAlign.Center" Style="color: var(--rz-success);">
                        Collaborateur créé avec succès
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" TextAlign="TextAlign.Center">
                        Compte créé pour <strong>@_emailEnvoye</strong>.
                    </RadzenText>
                    @* Message réel du serveur : contient le mot de passe temporaire si l'email n'est pas parti *@
                    <RadzenText TextStyle="TextStyle.Body2" TextAlign="TextAlign.Center" Style="overflow-wrap: anywhere;">
                        @_messageServeur
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" TextAlign="TextAlign.Center" Style="color: var(--rz-text-secondary-color);">
                        Il est automatiquement rattaché à votre entreprise.
                    </RadzenText>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Style="width: 100%;">
                        <RadzenButton Text="Créer un autre collaborateur" Icon="person_add" ButtonStyle="ButtonStyle.Primary"
                                      Variant="Variant.Outlined" Style="flex: 1;" Click="Reinitialiser" />
                        <RadzenButton Text="Tableau de bord" Icon="dashboard" ButtonStyle="ButtonStyle.Primary"
                                      Style="flex: 1;" Click='() => Navigation.NavigateTo("/dirigeant")' />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        }
        else
        {
            <RadzenCard Variant="Variant.Outlined">
                <Comp_FormCreerCollaborateur OnCree="OnCollaborateurCree" />
            </RadzenCard>
        }
    </RadzenColumn>
</RadzenRow>

@code {
    private bool _succes;
    private string _emailEnvoye = string.Empty;
    private string _messageServeur = string.Empty;

    private void OnCollaborateurCree(Comp_FormCreerCollaborateur.ResultatCreation p_resultat)
    {
        _succes = true;
        _emailEnvoye = p_resultat.Email;
        _messageServeur = p_resultat.Message;
    }

    private void Reinitialiser()
    {
        _succes = false;
        _emailEnvoye = string.Empty;
        _messageServeur = string.Empty;
    }
}
