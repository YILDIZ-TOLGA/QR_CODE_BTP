@page "/inscription"
@inject S_Auth SAuth
@inject NavigationManager Navigation
@inject NotificationService Notification

<RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="min-height: 85vh;">
    <RadzenColumn Size="12" SizeSM="10" SizeMD="6" SizeLG="5" SizeXL="4">
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Gap="1.5rem" AlignItems="AlignItems.Center">

                <RadzenIcon Icon="person_add" Style="font-size: 3rem; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" TextAlign="TextAlign.Center">
                    Créer un compte
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle1" TextAlign="TextAlign.Center" Style="color: var(--rz-text-secondary-color); margin-top: -1rem;">
                    Rejoignez BTPSecure en quelques clics
                </RadzenText>

                <RadzenTemplateForm TItem="DTO_Inscription" Data="_dto" Submit="Inscrire" Style="width: 100%;">
                    <RadzenStack Gap="1.25rem">

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Nom" Variant="Variant.Outlined" Style="width: 100%;">
                                    <Start>
                                        <RadzenIcon Icon="badge" />
                                    </Start>
                                    <ChildContent>
                                        <RadzenTextBox @bind-Value="_dto.Nom" Name="Nom" Style="width: 100%;" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="Nom" Text="Obligatoire." />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Prénom" Variant="Variant.Outlined" Style="width: 100%;">
                                    <Start>
                                        <RadzenIcon Icon="person" />
                                    </Start>
                                    <ChildContent>
                                        <RadzenTextBox @bind-Value="_dto.Prenom" Name="Prenom" Style="width: 100%;" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="Prenom" Text="Obligatoire." />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start>
                                <RadzenIcon Icon="mail" />
                            </Start>
                            <ChildContent>
                                <RadzenTextBox @bind-Value="_dto.Email" Name="Email" Style="width: 100%;" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="Email" Text="L'email est obligatoire." />
                                <RadzenEmailValidator Component="Email" Text="Email invalide." />
                            </Helper>
                        </RadzenFormField>

                        <RadzenFormField Text="Téléphone" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start>
                                <RadzenIcon Icon="phone" />
                            </Start>
                            <ChildContent>
                                <RadzenTextBox @bind-Value="_dto.Telephone" Style="width: 100%;" Placeholder="Optionnel" />
                            </ChildContent>
                        </RadzenFormField>

                        <RadzenFormField Text="Mot de passe" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start>
                                <RadzenIcon Icon="lock" />
                            </Start>
                            <ChildContent>
                                <RadzenPassword @bind-Value="_dto.MotDePasse" Name="MotDePasse" Style="width: 100%;" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="MotDePasse" Text="Le mot de passe est obligatoire." />
                                <RadzenLengthValidator Component="MotDePasse" Min="8" Text="Minimum 8 caractères." />
                            </Helper>
                        </RadzenFormField>

                        <RadzenFormField Text="Confirmer le mot de passe" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start>
                                <RadzenIcon Icon="lock_reset" />
                            </Start>
                            <ChildContent>
                                <RadzenPassword @bind-Value="_confirmMotDePasse" Name="ConfirmMdp" Style="width: 100%;" />
                            </ChildContent>
                            <Helper>
                                <RadzenCompareValidator Component="ConfirmMdp" Value="_dto.MotDePasse" Text="Les mots de passe ne correspondent pas." />
                            </Helper>
                        </RadzenFormField>

                        <RadzenFormField Text="Rôle" Variant="Variant.Outlined" Style="width: 100%;">
                            <Start>
                                <RadzenIcon Icon="work" />
                            </Start>
                            <ChildContent>
                                <RadzenDropDown @bind-Value="_dto.Role" Data="_roles" TextProperty="Text" ValueProperty="Value"
                                                Name="Role" Style="width: 100%;" Placeholder="Choisir un rôle..." />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="Role" Text="Le rôle est obligatoire." DefaultValue="default(Enum_Role)" />
                            </Helper>
                        </RadzenFormField>

                        @if (_dto.Role == Enum_Role.Fournisseur)
                        {
                            <RadzenFormField Text="Numéro SIRET (14 chiffres)" Variant="Variant.Outlined" Style="width: 100%;">
                                <Start>
                                    <RadzenIcon Icon="pin" />
                                </Start>
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="_dto.Siret" Name="Siret" Style="width: 100%;" Placeholder="12345678901234" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="Siret" Text="Le SIRET est obligatoire." />
                                </Helper>
                            </RadzenFormField>

                            <RadzenFormField Text="Numéro SIREN (9 chiffres, optionnel)" Variant="Variant.Outlined" Style="width: 100%;">
                                <Start>
                                    <RadzenIcon Icon="pin" />
                                </Start>
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="_dto.Siren" Style="width: 100%;" Placeholder="Optionnel" />
                                </ChildContent>
                            </RadzenFormField>
                        }

                        <RadzenButton Text="S'inscrire" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Large" Style="width: 100%;" IsBusy="_enChargement" Icon="how_to_reg" />
                    </RadzenStack>
                </RadzenTemplateForm>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                        Déjà un compte ?
                    </RadzenText>
                    <RadzenLink Path="/connexion" Text="Se connecter" Style="font-weight: 600;" />
                </RadzenStack>

            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@code {
    private DTO_Inscription _dto = new();
    private string _confirmMotDePasse = string.Empty;
    private bool _enChargement;

    private List<object> _roles = new()
    {
        new { Text = "Patron", Value = Enum_Role.Patron },
        new { Text = "Salarié", Value = Enum_Role.Salarie },
        new { Text = "Fournisseur", Value = Enum_Role.Fournisseur }
    };

    private async Task Inscrire()
    {
        _enChargement = true;
        var (_succes, _message) = await SAuth.Inscrire(_dto);
        _enChargement = false;

        if (_succes)
        {
            Notification.Notify(NotificationSeverity.Success, "Succès", _message);
            Navigation.NavigateTo("/connexion");
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }
}
