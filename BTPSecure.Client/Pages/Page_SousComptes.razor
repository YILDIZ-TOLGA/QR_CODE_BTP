@page "/fournisseur/sous-comptes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Fournisseur")]
@inject Services.S_SousCompte SSousCompte
@inject NotificationService Notification
@inject DialogService Dialog

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom: 1.5rem;">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenIcon Icon="badge" Style="font-size: 2rem; color: var(--rz-primary);" />
        <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Mes sous-comptes</RadzenText>
        @if (!_chargement)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{_quota.Actifs} / {_quota.Limite}")" IsPill="true" />
        }
    </RadzenStack>
    <RadzenButton Text="Ajouter" Icon="person_add" ButtonStyle="ButtonStyle.Primary" Click="OuvrirAjout" Disabled="@LimiteAtteinte()" />
</RadzenStack>

@if (_chargement)
{
    <RadzenRow JustifyContent="JustifyContent.Center" Style="margin-top: 4rem;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
    </RadzenRow>
}
else
{
    <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color); margin-bottom: 1rem;">
        Les sous-comptes permettent à vos employés de valider des codes sous votre entreprise. Chaque validation est tracée à leur nom.
    </RadzenText>

    @if (LimiteAtteinte())
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" AllowClose="false" Style="margin-bottom: 1rem;">
            Nombre de sous-comptes atteint (@_quota.Limite maximum). Désactivez un sous-compte pour libérer une place, ou contactez l'administrateur pour augmenter la limite.
        </RadzenAlert>
    }

    @if (_sousComptes.Count == 0)
    {
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 3rem 0;">
                <RadzenIcon Icon="group_off" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
                <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-text-secondary-color);">Aucun sous-compte</RadzenText>
                <RadzenButton Text="Créer mon premier sous-compte" Icon="person_add" ButtonStyle="ButtonStyle.Primary" Click="OuvrirAjout" Disabled="@LimiteAtteinte()" />
            </RadzenStack>
        </RadzenCard>
    }
    else
    {
        <RadzenRow Gap="1rem">
            @foreach (var _s in _sousComptes)
            {
                <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                    <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                        <RadzenStack Gap="0.75rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="min-width: 0; flex: 1;">
                                    <RadzenIcon Icon="account_circle" Style="font-size: 1.8rem; color: var(--rz-primary);" />
                                    <RadzenText Style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@_s.Prenom @_s.Nom</RadzenText>
                                </RadzenStack>
                                @if (_s.EstActif)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Actif" IsPill="true" />
                                }
                                else
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Désactivé" IsPill="true" />
                                }
                            </RadzenStack>

                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                <RadzenIcon Icon="mail" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); overflow: hidden; text-overflow: ellipsis;">@_s.Email</RadzenText>
                            </RadzenStack>

                            @if (_s.EstActif)
                            {
                                <RadzenButton Text="Désactiver" Icon="block" ButtonStyle="ButtonStyle.Danger"
                                              Variant="Variant.Outlined" Size="ButtonSize.Small" Style="width: 100%;"
                                              Click="() => Desactiver(_s)" />
                            }
                            else
                            {
                                <RadzenButton Text="Réactiver" Icon="check_circle" ButtonStyle="ButtonStyle.Success"
                                              Variant="Variant.Outlined" Size="ButtonSize.Small" Style="width: 100%;"
                                              Click="() => Reactiver(_s)" />
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            }
        </RadzenRow>
    }
}

@code {
    private List<DTO_SousCompte> _sousComptes = new();
    private DTO_QuotaSousComptes _quota = new();
    private bool _chargement = true;

    protected override async Task OnInitializedAsync()
    {
        await Recharger();
    }

    private async Task Recharger()
    {
        _chargement = true;
        _sousComptes = await SSousCompte.Lister();
        _quota = await SSousCompte.ObtenirQuota();
        _chargement = false;
    }

    private bool LimiteAtteinte()
    {
        if (_chargement)
        {
            return false;
        }
        return _quota.Actifs >= _quota.Limite;
    }

    private async Task OuvrirAjout()
    {
        var _result = await Dialog.OpenAsync<Comp_DialogSousCompte>("Ajouter un sous-compte",
            new Dictionary<string, object?>(),
            new DialogOptions { Width = "500px", CloseDialogOnOverlayClick = false });

        if (_result is DTO_CreerSousCompte _dto)
        {
            var (_succes, _message) = await SSousCompte.Creer(_dto);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Success, "Succès", "Sous-compte créé. Ses identifiants lui ont été envoyés par email.");
                await Recharger();
            }
            else
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private async Task Desactiver(DTO_SousCompte p_s)
    {
        var _confirm = await Dialog.Confirm(
            $"Désactiver le sous-compte « {p_s.Prenom} {p_s.Nom} » ? Il ne pourra plus se connecter.",
            "Confirmation",
            new ConfirmOptions { OkButtonText = "Désactiver", CancelButtonText = "Annuler" });
        if (_confirm == true)
        {
            var (_succes, _message) = await SSousCompte.Desactiver(p_s.Id);
            if (_succes)
            {
                Notification.Notify(NotificationSeverity.Success, "Succès", _message);
                await Recharger();
            }
            else
                Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private async Task Reactiver(DTO_SousCompte p_s)
    {
        var (_succes, _message) = await SSousCompte.Reactiver(p_s.Id);
        if (_succes)
        {
            Notification.Notify(NotificationSeverity.Success, "Succès", _message);
            await Recharger();
        }
        else
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
    }
}
