@page "/profil"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject Services.S_Profil SProfil
@inject NotificationService Notification
@using BTPSecure.Shared.Enums

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1.5rem;">
    <RadzenIcon Icon="account_circle" Style="font-size: 2rem; color: var(--rz-primary);" />
    <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Mon profil</RadzenText>
</RadzenStack>

@if (_chargement)
{
    <RadzenRow JustifyContent="JustifyContent.Center" Style="margin-top: 4rem;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
    </RadzenRow>
}
else if (_profil == null)
{
    <RadzenCard Variant="Variant.Outlined">
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 2rem 0;">
            <RadzenIcon Icon="error" Style="font-size: 3rem; color: var(--rz-danger);" />
            <RadzenText TextStyle="TextStyle.H6">Impossible de charger le profil.</RadzenText>
        </RadzenStack>
    </RadzenCard>
}
else
{
    <RadzenStack Gap="1.25rem">

        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="margin-bottom: 1rem;">
                <RadzenIcon Icon="badge" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Informations personnelles</RadzenText>
            </RadzenStack>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Nom</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 600;">@_profil.Nom</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Prénom</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 600;">@_profil.Prenom</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Email</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1">@_profil.Email</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Téléphone</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1">
                            @if (string.IsNullOrEmpty(_profil.Telephone))
                            {
                                <span style="color: var(--rz-text-disabled-color);">Non renseigné</span>
                            }
                            else
                            {
                                @_profil.Telephone
                            }
                        </RadzenText>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="margin-bottom: 1rem;">
                <RadzenIcon Icon="work" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Compte</RadzenText>
            </RadzenStack>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Rôle</RadzenText>
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@ObtenirLibelleRole(_profil.Role)" IsPill="true" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Membre depuis</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1">@_profil.DateCreation.ToLocalTime().ToString("dd/MM/yyyy")</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        @if (_profil.Role == Enum_Role.Fournisseur)
        {
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="margin-bottom: 1rem;">
                    <RadzenIcon Icon="domain" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Identité entreprise</RadzenText>
                </RadzenStack>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">SIRET</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" Style="font-family: monospace;">
                                @if (string.IsNullOrEmpty(_profil.Siret))
                                {
                                    <span style="color: var(--rz-text-disabled-color);">Non renseigné</span>
                                }
                                else
                                {
                                    @_profil.Siret
                                }
                            </RadzenText>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">SIREN</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" Style="font-family: monospace;">
                                @if (string.IsNullOrEmpty(_profil.Siren))
                                {
                                    <span style="color: var(--rz-text-disabled-color);">Non renseigné</span>
                                }
                                else
                                {
                                    @_profil.Siren
                                }
                            </RadzenText>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        }

        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="margin-bottom: 1rem;">
                <RadzenIcon Icon="lock" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Changer mon mot de passe</RadzenText>
            </RadzenStack>

            <RadzenTemplateForm TItem="ChangeMdpForm" Data="_formMdp" Submit="ChangerMotDePasse">
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="Ancien mot de passe" Variant="Variant.Outlined" Style="width: 100%;">
                        <Start><RadzenIcon Icon="lock_outline" /></Start>
                        <ChildContent>
                            @if (_voirAncien)
                            {
                                <RadzenTextBox @bind-Value="_formMdp.Ancien" Name="Ancien" Style="width: 100%;" />
                            }
                            else
                            {
                                <RadzenPassword @bind-Value="_formMdp.Ancien" Name="Ancien" Style="width: 100%;" />
                            }
                        </ChildContent>
                        <End>
                            <RadzenButton Icon="@(_voirAncien ? "visibility_off" : "visibility")"
                                          Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                          Click="@(() => _voirAncien = !_voirAncien)" type="button" />
                        </End>
                        <Helper>
                            <RadzenRequiredValidator Component="Ancien" Text="Obligatoire." />
                        </Helper>
                    </RadzenFormField>

                    <RadzenFormField Text="Nouveau mot de passe" Variant="Variant.Outlined" Style="width: 100%;">
                        <Start><RadzenIcon Icon="lock" /></Start>
                        <ChildContent>
                            @if (_voirNouveau)
                            {
                                <RadzenTextBox @bind-Value="_formMdp.Nouveau" Name="Nouveau" Style="width: 100%;" />
                            }
                            else
                            {
                                <RadzenPassword @bind-Value="_formMdp.Nouveau" Name="Nouveau" Style="width: 100%;" />
                            }
                        </ChildContent>
                        <End>
                            <RadzenButton Icon="@(_voirNouveau ? "visibility_off" : "visibility")"
                                          Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                          Click="@(() => _voirNouveau = !_voirNouveau)" type="button" />
                        </End>
                        <Helper>
                            <RadzenRequiredValidator Component="Nouveau" Text="Obligatoire." />
                            <RadzenLengthValidator Component="Nouveau" Min="8" Text="Minimum 8 caractères." />
                        </Helper>
                    </RadzenFormField>

                    <RadzenFormField Text="Confirmer le nouveau mot de passe" Variant="Variant.Outlined" Style="width: 100%;">
                        <Start><RadzenIcon Icon="lock_reset" /></Start>
                        <ChildContent>
                            @if (_voirConfirmation)
                            {
                                <RadzenTextBox @bind-Value="_formMdp.Confirmation" Name="ConfMdp" Style="width: 100%;" />
                            }
                            else
                            {
                                <RadzenPassword @bind-Value="_formMdp.Confirmation" Name="ConfMdp" Style="width: 100%;" />
                            }
                        </ChildContent>
                        <End>
                            <RadzenButton Icon="@(_voirConfirmation ? "visibility_off" : "visibility")"
                                          Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                          Click="@(() => _voirConfirmation = !_voirConfirmation)" type="button" />
                        </End>
                        <Helper>
                            <RadzenCompareValidator Component="ConfMdp" Value="_formMdp.Nouveau" Text="Les mots de passe ne correspondent pas." />
                        </Helper>
                    </RadzenFormField>

                    <RadzenButton Text="Modifier mon mot de passe" ButtonType="ButtonType.Submit" Icon="save"
                                  ButtonStyle="ButtonStyle.Primary" Style="width: 100%;" IsBusy="_changementEnCours" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>

        @if ((_profil.Role == Enum_Role.Patron || _profil.Role == Enum_Role.Salarie) && _profil.Entreprises.Count > 0)
        {
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="margin-bottom: 1rem;">
                    <RadzenIcon Icon="business" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Mes entreprises</RadzenText>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    @foreach (var _nom in _profil.Entreprises)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@_nom" IsPill="true" />
                    }
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>
}

@code {
    private DTO_Profil? _profil;
    private bool _chargement = true;
    private ChangeMdpForm _formMdp = new();
    private bool _changementEnCours;
    private bool _voirAncien;
    private bool _voirNouveau;
    private bool _voirConfirmation;

    protected override async Task OnInitializedAsync()
    {
        _profil = await SProfil.ObtenirMoi();
        _chargement = false;
    }

    private async Task ChangerMotDePasse()
    {
        _changementEnCours = true;
        var (_ok, _message) = await SProfil.ChangerMotDePasse(_formMdp.Ancien, _formMdp.Nouveau);
        _changementEnCours = false;

        if (_ok)
        {
            Notification.Notify(NotificationSeverity.Success, "Succès", _message);
            _formMdp = new ChangeMdpForm();
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Erreur", _message);
        }
    }

    private static string ObtenirLibelleRole(Enum_Role p_role)
    {
        if (p_role == Enum_Role.Admin)
        {
            return "Admin";
        }
        if (p_role == Enum_Role.Patron)
        {
            return "Dirigeant";
        }
        if (p_role == Enum_Role.Salarie)
        {
            return "Collaborateur";
        }
        if (p_role == Enum_Role.Fournisseur)
        {
            return "Fournisseur";
        }
        return p_role.ToString();
    }

    private class ChangeMdpForm
    {
        public string Ancien { get; set; } = string.Empty;
        public string Nouveau { get; set; } = string.Empty;
        public string Confirmation { get; set; } = string.Empty;
    }
}
