@page "/apporteur"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ApporteurAffaire")]
@inject Services.S_Apporteur SApporteur

@* Espace de l'apporteur d'affaires : son code de parrainage, ses filleuls et ses gains *@

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem" Style="margin-bottom: 1.5rem;">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenIcon Icon="handshake" Style="font-size: 2rem; color: var(--rz-primary);" />
        <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Mon parrainage</RadzenText>
    </RadzenStack>
    <Comp_AutoRefresh OnRefresh="RafraichirUi" />
</RadzenStack>

@if (_chargement)
{
    <RadzenRow JustifyContent="JustifyContent.Center" Style="margin-top: 4rem;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
    </RadzenRow>
}
else
{
    <RadzenStack Gap="1.5rem">

        @* Le code : c'est la première chose qu'il vient chercher, donc en haut et en grand *@
        <RadzenCard Variant="Variant.Flat" Style="background: var(--rz-primary); color: white;">
            <RadzenStack Gap="0.75rem" AlignItems="AlignItems.Center" Style="padding: 0.5rem 0;">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; color: white;">
                    Votre code de parrainage
                </RadzenText>
                <RadzenText TextStyle="TextStyle.H3" Style="margin: 0; color: white; font-family: monospace; letter-spacing: 4px; font-weight: 700;">
                    @_tableau.CodeParrainage
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center" Style="margin: 0; color: white;">
                    Communiquez-le à un dirigeant : s'il le saisit à son inscription,
                    il apparaîtra ci-dessous.
                </RadzenText>
            </RadzenStack>
        </RadzenCard>

        @* Statistiques *@
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenIcon Icon="groups" Style="font-size: 2.5rem; color: var(--rz-primary);" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@_tableau.NombreFilleuls</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Personnes amenées</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenIcon Icon="hourglass_top" Style="font-size: 2.5rem; color: var(--rz-warning);" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@_tableau.NombreEnAttente</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">En attente de validation</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenIcon Icon="euro" Style="font-size: 2.5rem; color: var(--rz-success);" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@_tableau.TotalCumule.ToString("0.##") €</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Total cumulé</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        @* Liste des filleuls *@
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 1rem;">
                <RadzenIcon Icon="groups" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Personnes que j'ai amenées</RadzenText>
            </RadzenStack>

            @if (_tableau.Filleuls.Count == 0)
            {
                <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 2.5rem 0;">
                    <RadzenIcon Icon="person_search" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
                    <RadzenText TextStyle="TextStyle.Body2" TextAlign="TextAlign.Center" Style="color: var(--rz-text-secondary-color);">
                        Personne pour l'instant.
                    </RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.Center">
                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; color: var(--rz-text-secondary-color);">
                            Partagez votre code
                        </RadzenText>
                        <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="@_tableau.CodeParrainage" IsPill="true" />
                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; color: var(--rz-text-secondary-color);">
                            pour commencer.
                        </RadzenText>
                    </RadzenStack>
                </RadzenStack>
            }
            else
            {
                <RadzenStack Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                        Une commission devient acquise lorsqu'un administrateur valide
                        l'entreprise de la personne amenée. Le montant est fixé à ce moment-là.
                    </RadzenText>

                    @foreach (var _f in _tableau.Filleuls)
                    {
                        <RadzenCard Variant="Variant.Outlined">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">

                                <RadzenStack Gap="0.3rem">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">
                                        @_f.PrenomFilleul @_f.NomFilleul
                                    </RadzenText>
                                    @if (!string.IsNullOrEmpty(_f.NomEntreprise))
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                            <RadzenIcon Icon="business" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">@_f.NomEntreprise</RadzenText>
                                        </RadzenStack>
                                    }
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                        Inscrit le @_f.DateInscription.ToLocalTime().ToString("dd/MM/yyyy")
                                    </RadzenText>
                                </RadzenStack>

                                <RadzenStack Gap="0.4rem" AlignItems="AlignItems.End">
                                    @if (_f.EstValide)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Validé" IsPill="true" />
                                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: var(--rz-success);">
                                            @_f.MontantCommission.ToString("0.##") €
                                        </RadzenText>
                                        @if (_f.DateValidation.HasValue)
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                le @_f.DateValidation.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                            </RadzenText>
                                        }
                                    }
                                    else
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="En attente" IsPill="true" />
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                            Commission non encore fixée
                                        </RadzenText>
                                    }
                                </RadzenStack>

                            </RadzenStack>
                        </RadzenCard>
                    }
                </RadzenStack>
            }
        </RadzenCard>

    </RadzenStack>
}

@code {
    private DTO_TableauApporteur _tableau = new();
    private bool _chargement = true;

    protected override async Task OnInitializedAsync()
    {
        _tableau = await SApporteur.ObtenirTableauDeBord();
        _chargement = false;
    }

    private async Task RafraichirUi()
    {
        _tableau = await SApporteur.ObtenirTableauDeBord();
        StateHasChanged();
    }
}
