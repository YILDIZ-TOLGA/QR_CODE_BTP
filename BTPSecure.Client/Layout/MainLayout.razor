@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject S_Auth SAuth
@inject Services.S_Code SCode
@inject Services.S_SousCompte SSousCompte
@inject Services.S_Ticket STicket
@inject Services.S_EtatUi SEtatUi
@inject Services.S_Profil SProfil
@inject AuthenticationStateProvider AuthStateProvider

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween"
                     Style="padding: 0 1.25rem; width: 100%; height: 100%;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                @if (_estConnecte)
                {
                    <RadzenButton Icon="menu" Click="@(() => _sidebarExpanded = !_sidebarExpanded)"
                                  Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" />
                }
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                             Style="cursor: pointer;" @onclick='() => Navigation.NavigateTo("/")'>
                    <RadzenIcon Icon="shield" Style="color: white; font-size: 1.5rem;" />
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: white; font-weight: 700; letter-spacing: 0.5px;">
                        KEIDO
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>

            @if (_estConnecte)
            {
                <RadzenButton Text="Déconnexion" Icon="logout" Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="Deconnecter" />
            }
        </RadzenStack>
    </RadzenHeader>

    @if (_estConnecte)
    {
        @* Sans bouton : sert uniquement à tenir les badges de la sidebar à jour (60 s, en pause si l'onglet est masqué) *@
        <Comp_AutoRefresh OnRefresh="RafraichirCompteurs" AfficherBouton="false" />

        <RadzenSidebar @bind-Expanded="_sidebarExpanded" Style="z-index: 2; display: flex; flex-direction: column;">
            @* Identité de l'utilisateur, tout en haut *@
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.6rem"
                         Style="padding: 1rem; border-bottom: 1px solid var(--rz-border); background: var(--rz-base-50);">
                <RadzenIcon Icon="account_circle" Style="color: var(--rz-primary); font-size: 2rem;" />
                <RadzenStack Gap="0" Style="min-width: 0;">
                    @if (!string.IsNullOrEmpty(_entrepriseAffiche))
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-primary); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            @_entrepriseAffiche
                        </RadzenText>
                    }
                    <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @_nomAffiche
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>

            <div style="flex: 1; overflow-y: auto;">
                <RadzenPanelMenu>
                    @if (_role == "Admin")
                    {
                        <RadzenPanelMenuItem Text="Administration" Icon="admin_panel_settings" Path="admin" Match="NavLinkMatch.All" />
                    }
                    @if (_role == "Dirigeant")
                    {
                        <RadzenPanelMenuItem Text="Tableau de bord" Icon="dashboard" Path="dirigeant" Match="NavLinkMatch.All" />
                        <RadzenPanelMenuItem Text="Générer un code" Icon="add_circle" Path="dirigeant/creer-code" Match="NavLinkMatch.All" />
                        <RadzenPanelMenuItem Text="Création collaborateur" Icon="person_add" Path="dirigeant/creer-collaborateur" Match="NavLinkMatch.All" />
                        <RadzenPanelMenuItem Text="Mes fournisseurs" Icon="contacts" Path="dirigeant/fournisseurs" Match="NavLinkMatch.All" />
                        <RadzenPanelMenuItem Text="Notifications" Icon="notifications" Path="dirigeant/notifications" Match="NavLinkMatch.All" />
                    }
                    @if (_role == "Collaborateur")
                    {
                        <RadzenPanelMenuItem Text="Mes codes" Icon="qr_code" Path="collaborateur" Match="NavLinkMatch.All" />
                        @if (_peutCreerCodes)
                        {
                            <RadzenPanelMenuItem Text="Tableau de bord" Icon="dashboard" Path="dirigeant" Match="NavLinkMatch.All" />
                            <RadzenPanelMenuItem Text="Générer un code" Icon="add_circle" Path="dirigeant/creer-code" Match="NavLinkMatch.All" />
                        }
                    }
                    @if (_role == "Fournisseur")
                    {
                        <RadzenPanelMenuItem Text="Accueil" Icon="home" Path="fournisseur" Match="NavLinkMatch.All" />
                        <RadzenPanelMenuItem Text="À préparer" Icon="pending_actions" Path="fournisseur/a-preparer" Match="NavLinkMatch.All">
                            @* Le Template ne remplace QUE le texte : l'icône vient de l'attribut Icon *@
                            <Template>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenText Style="margin: 0;">À préparer</RadzenText>
                                    @if (_commandesAPreparer > 0)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@_commandesAPreparer.ToString()" IsPill="true" />
                                    }
                                </RadzenStack>
                            </Template>
                        </RadzenPanelMenuItem>
                        <RadzenPanelMenuItem Text="Prêtes" Icon="task_alt" Path="fournisseur/pretes" Match="NavLinkMatch.All" />
                        @if (_estFournisseurPrincipal)
                        {
                            <RadzenPanelMenuItem Text="Mes sous-comptes" Icon="badge" Path="fournisseur/sous-comptes" Match="NavLinkMatch.All" />
                            <RadzenPanelMenuItem Text="Blacklist" Icon="block" Path="fournisseur/blacklist" Match="NavLinkMatch.All" />
                            <RadzenPanelMenuItem Text="Historique" Icon="history" Path="fournisseur/historique" Match="NavLinkMatch.All" />
                        }
                    }
                    @if (_role != "Admin")
                    {
                        <RadzenPanelMenuItem Text="@LibelleMessagerie()" Icon="forum" Path="messagerie" Match="NavLinkMatch.All" />
                    }
                    @* Le pense-bête est personnel : tout le monde y a droit, Admin compris *@
                    <RadzenPanelMenuItem Text="Prêt de matériel" Icon="sticky_note_2" Path="memo" Match="NavLinkMatch.All" />
                    <RadzenPanelMenuItem Text="Mon profil" Icon="account_circle" Path="profil" Match="NavLinkMatch.All" />
                </RadzenPanelMenu>
            </div>

            <RadzenStack Style="padding: 1rem; border-top: 1px solid var(--rz-border); background: var(--rz-base-50);">
                <RadzenButton Text="Déconnexion" Icon="logout" ButtonStyle="ButtonStyle.Danger"
                              Variant="Variant.Outlined" Size="ButtonSize.Small" Style="width: 100%;" Click="Deconnecter" />
            </RadzenStack>
        </RadzenSidebar>
    }

    <RadzenBody>
        <RadzenRow Style="padding: 1.5rem;">
            @* Sécurité : un élément flex a min-width:auto et refuse donc de rétrécir sous la
               largeur de son contenu. min-width:0 évite qu'un contenu large fasse déborder la page. *@
            <RadzenColumn Style="min-width: 0;">
                @Body
            </RadzenColumn>
        </RadzenRow>
    </RadzenBody>
</RadzenLayout>

<RadzenComponents />

@code {
    private bool _sidebarExpanded = true;
    private bool _estConnecte = false;
    private string _email = "";
    private string _role = "";
    private string _nomAffiche = "";
    private string _entrepriseAffiche = "";
    private bool _peutCreerCodes = false;
    private bool _estFournisseurPrincipal = false;
    private int _messagesNonLus = 0;
    private int _commandesAPreparer = 0;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        SEtatUi.CompteursChanges += OnCompteursChanges;
        await MettreAJourEtat();
    }

    // Une page signale une action (commande prête, message lu...) → on remet les badges à jour
    private async void OnCompteursChanges()
    {
        await MettreAJourCompteurs();
        await InvokeAsync(StateHasChanged);
    }

    // Rafraîchissement périodique (60 s) : les badges suivent même depuis un autre onglet
    private async Task RafraichirCompteurs()
    {
        await MettreAJourCompteurs();
        StateHasChanged();
    }

    // Les compteurs de la sidebar sont rafraîchis à chaque navigation
    private async void OnLocationChanged(object? p_sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs p_e)
    {
        await MettreAJourCompteurs();
        await InvokeAsync(StateHasChanged);
    }

    private async Task MettreAJourCompteurs()
    {
        _messagesNonLus = 0;
        if (_estConnecte && _role != "Admin")
        {
            _messagesNonLus = await STicket.CompterNonLus();
        }

        _commandesAPreparer = 0;
        if (_estConnecte && _role == "Fournisseur")
        {
            _commandesAPreparer = await SCode.CompterCommandesAPreparer();
        }
    }

    private string LibelleMessagerie()
    {
        if (_messagesNonLus > 0)
            return $"Messagerie ({_messagesNonLus})";
        return "Messagerie";
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> p_tache)
    {
        await MettreAJourEtat();
        await InvokeAsync(StateHasChanged);
    }

    private async Task MettreAJourEtat()
    {
        var _etat = await AuthStateProvider.GetAuthenticationStateAsync();

        if (_etat.User.Identity == null || !_etat.User.Identity.IsAuthenticated)
        {
            _estConnecte = false;
            _email = "";
            _role = "";
            _nomAffiche = "";
            _entrepriseAffiche = "";
            return;
        }

        _estConnecte = true;

        var _claimEmail = _etat.User.FindFirst(System.Security.Claims.ClaimTypes.Email);
        if (_claimEmail != null)
        {
            _email = _claimEmail.Value;
        }

        var _claimRole = _etat.User.FindFirst(System.Security.Claims.ClaimTypes.Role);
        if (_claimRole != null)
        {
            _role = _claimRole.Value;
        }

        // Nom/prénom + entreprise pour l'entête de la sidebar (le JWT ne les contient pas)
        _nomAffiche = _email;
        _entrepriseAffiche = "";
        var _profil = await SProfil.ObtenirMoi();
        if (_profil != null)
        {
            _nomAffiche = $"{_profil.Prenom} {_profil.Nom}";
            if (_profil.Entreprises.Count > 0)
                _entrepriseAffiche = _profil.Entreprises[0];
        }

        // Un Collaborateur Responsable Admin peut créer des codes → afficher le menu
        _peutCreerCodes = false;
        if (_role == "Collaborateur")
        {
            var _ctx = await SCode.ObtenirContexteCreation();
            _peutCreerCodes = _ctx.PeutCreer;
        }

        // Un fournisseur principal (pas un sous-compte) gère ses sous-comptes + historique
        _estFournisseurPrincipal = false;
        if (_role == "Fournisseur")
        {
            _estFournisseurPrincipal = await SSousCompte.EstPrincipal();
        }

        await MettreAJourCompteurs();
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        SEtatUi.CompteursChanges -= OnCompteursChanges;
    }

    private async Task Deconnecter()
    {
        await SAuth.Deconnecter();
        Navigation.NavigateTo("/connexion", true);
    }
}
