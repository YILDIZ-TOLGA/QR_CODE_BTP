@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject S_Auth SAuth

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween"
                     Style="padding: 0 1.25rem; width: 100%; height: 100%;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenButton Icon="menu" Click="@(() => _sidebarExpanded = !_sidebarExpanded)"
                              Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" />
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                             Style="cursor: pointer;" @onclick='() => Navigation.NavigateTo("/")'>
                    <RadzenIcon Icon="shield" Style="color: white; font-size: 1.5rem;" />
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: white; font-weight: 700; letter-spacing: 0.5px;">
                        BTPSecure
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>

            <AuthorizeView>
                <Authorized>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="account_circle" Style="color: rgba(255,255,255,0.8); font-size: 1.3rem;" />
                            <RadzenText TextStyle="TextStyle.Body2" Style="color: rgba(255,255,255,0.9);">
                                @context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                            </RadzenText>
                        </RadzenStack>
                        <RadzenButton Text="Déconnexion" Icon="logout" Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="Deconnecter" />
                    </RadzenStack>
                </Authorized>
            </AuthorizeView>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="_sidebarExpanded" Style="z-index: 2;">
        <RadzenPanelMenu>
            <AuthorizeView Roles="Admin">
                <RadzenPanelMenuItem Text="Administration" Icon="admin_panel_settings" Path="admin" />
            </AuthorizeView>
            <AuthorizeView Roles="Patron">
                <RadzenPanelMenuItem Text="Tableau de bord" Icon="dashboard" Path="patron" />
                <RadzenPanelMenuItem Text="Créer un code" Icon="add_circle" Path="patron/creer-code" />
            </AuthorizeView>
            <AuthorizeView Roles="Salarie">
                <RadzenPanelMenuItem Text="Mes codes" Icon="qr_code" Path="salarie" />
            </AuthorizeView>
            <AuthorizeView Roles="Fournisseur">
                <RadzenPanelMenuItem Text="Valider un code" Icon="verified" Path="fournisseur" />
            </AuthorizeView>
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <RadzenRow Style="padding: 1.5rem;">
            <RadzenColumn>
                @Body
            </RadzenColumn>
        </RadzenRow>
    </RadzenBody>
</RadzenLayout>

<RadzenComponents />

@code {
    private bool _sidebarExpanded = true;

    private async Task Deconnecter()
    {
        await SAuth.Deconnecter();
        Navigation.NavigateTo("/connexion", true);
    }
}
